# Local installers, extracted host distributions, and pristine reference copies.
# Source fixtures and the reports under validation/ remain versionable.
/bins/
/unpacked/
/pristine_*/

# Out-of-source builds, staging, and release packaging.
/build/
/build-*/
/cmake-build-*/
/out/
/dist/
/stage/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/

# CMake/CTest/Ninja artifacts from an accidental in-source build.
/CMakeFiles/
/CMakeCache.txt
/CMakeUserPresets.json
/cmake_install.cmake
/install_manifest*.txt
/CTestTestfile.cmake
/DartConfiguration.tcl
/Testing/
/_deps/
/CPackConfig.cmake
/CPackSourceConfig.cmake
/_CPack_Packages/
/compile_commands.json
/build.ninja
/rules.ninja
.ninja_deps
.ninja_log

# Native objects, libraries, executables, Fortran modules, and debug symbols.
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.app/
*.mod
*.smod
*.MOD
*.SMOD
*.d
*.dSYM/
*.pdb
*.ilk
*.exp
*.manifest.res
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
/native_lifecycle
/platform_memory

# Analysis databases, native sidecars, and backups made by the historical patcher.
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.freelumina.orig*

# Python bytecode, local environments, test caches, and coverage output.
__pycache__/
*.py[cod]
/.venv/
/venv/
/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/
/coverage/
/coverage.xml
*.egg-info/

# Machine-specific editor state and language-server caches.
.idea/
.vs/
.cache/
.clangd/
.ccls-cache/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.ipch
*.swp
*.swo
*~

# OS metadata, temporary files, and crash dumps.
.DS_Store
._*
.AppleDouble/
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.stackdump
*.dmp
/core
/core.*

# Local environment settings; sanitized examples can be shared.
.env
.env.*
!.env.example
!.env.sample
