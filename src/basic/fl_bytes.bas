170 REM BYTE ORDER AND SIGNED ADDRESS ARITHMETIC
#INCLUDE ONCE "core.bi"

180 FUNCTION F_ADDRESS_SUM CDECL(BYVAL V_ADDRESS AS LONGINT, BYVAL V_DISPLACEMENT AS LONGINT) AS LONGINT
190     DIM V_VALUE AS LONGINT
200     V_VALUE = 0
210     IF V_ADDRESS < 0 THEN
220         RETURN V_VALUE
230     END IF
240     IF V_DISPLACEMENT >= 0 THEN
250         IF V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - V_DISPLACEMENT THEN
260             RETURN V_VALUE
270         END IF
280     ELSE
290         IF V_DISPLACEMENT < -&H7FFFFFFFFFFFFFFFLL THEN
300             RETURN V_VALUE
310         END IF
320         IF V_ADDRESS < -V_DISPLACEMENT THEN
330             RETURN V_VALUE
340         END IF
350     END IF
360     V_VALUE = V_ADDRESS + V_DISPLACEMENT
370     RETURN V_VALUE
380 END FUNCTION

390 FUNCTION F_BYTE_VALUE CDECL(BYVAL V_B AS BYTE) AS LONGINT
400     DIM V_VALUE AS LONGINT
410     V_VALUE = (CLNGINT(V_B) AND (255LL))
420     RETURN V_VALUE
430 END FUNCTION

440 FUNCTION F_BYTE_AT CDECL(BYVAL V_VALUE AS LONGINT) AS BYTE
450     DIM V_TRUNCATED AS LONGINT
460     DIM V_B AS BYTE
470     V_TRUNCATED = (V_VALUE AND (255LL))
480     IF V_TRUNCATED > 127 THEN
490         V_TRUNCATED = V_TRUNCATED - 256
500     END IF
510     V_B = CLNGINT(V_TRUNCATED)
520     RETURN V_B
530 END FUNCTION

540 FUNCTION F_LOAD_LE CDECL(BYVAL V_BYTES AS BYTE PTR, BYVAL N_BYTES AS LONGINT, BYVAL V_COUNT AS LONG) AS LONGINT
550     DIM V_K AS LONG
560     DIM V_VALUE AS LONGINT
570     V_VALUE = 0
580     IF V_BYTES = 0 ORELSE V_COUNT < 0 ORELSE V_COUNT > 8 ORELSE V_COUNT > N_BYTES THEN RETURN 0
590     FOR V_K = 1 TO V_COUNT
600         V_VALUE = (V_VALUE OR ((F_BYTE_VALUE(V_BYTES[V_K - 1]) SHL (8*(V_K - 1)))))
610     NEXT
620     RETURN V_VALUE
630 END FUNCTION

640 SUB F_STORE_LE CDECL(BYVAL V_BYTES AS BYTE PTR, BYVAL N_BYTES AS LONGINT, BYVAL V_VALUE AS LONGINT, BYVAL V_COUNT AS LONG)
650     DIM V_K AS LONG
660     IF V_BYTES = 0 ORELSE V_COUNT < 0 ORELSE V_COUNT > 8 ORELSE V_COUNT > N_BYTES THEN EXIT SUB
670     FOR V_K = 1 TO V_COUNT
680         V_BYTES[V_K - 1] = F_BYTE_AT((CULNGINT(V_VALUE) SHR (8*(V_K - 1))))
690     NEXT
700 END SUB

710 FUNCTION F_SIGNED_FIELD CDECL(BYVAL V_VALUE AS LONGINT, BYVAL V_BITS AS LONG) AS LONGINT
720     DIM V_FIELD AS LONGINT
730     V_FIELD = FL_BITS(V_VALUE, 0, V_BITS)
740     IF ((V_FIELD AND (1ULL SHL (V_BITS - 1))) <> 0) THEN
750         V_FIELD = (V_FIELD OR ((NOT (FL_MASK(V_BITS)))))
760     END IF
770     RETURN V_FIELD
780 END FUNCTION

790 FUNCTION F_FITS_SIGNED CDECL(BYVAL V_VALUE AS LONGINT, BYVAL V_BITS AS LONG) AS LONG
800     DIM V_LIMIT AS LONGINT
810     DIM V_FITS AS LONG
820     V_LIMIT = (1LL SHL (V_BITS - 1))
830     V_FITS = V_VALUE >= -V_LIMIT  ANDALSO  V_VALUE < V_LIMIT
840     RETURN V_FITS
850 END FUNCTION
