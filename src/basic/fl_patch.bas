11800 REM BUILD DIRECT BRANCHES AND RELOCATE THE ENTRY PREFIX
#INCLUDE ONCE "core.bi"

11810 FUNCTION FL_PLAN CDECL ALIAS "fl_plan"(BYVAL V_ARCH AS LONG, BYVAL V_ABI AS LONG, BYVAL V_INPUT AS BYTE PTR, BYVAL V_INPUT_SIZE AS ULONGINT, BYVAL V_ADDRESS AS LONGINT, BYVAL V_TRAMPOLINE AS LONGINT, BYVAL V_OUTPUT AS BYTE PTR, BYREF V_CODE_SIZE AS LONG, BYVAL V_PATCH AS BYTE PTR, BYREF V_PATCH_SIZE AS LONG) AS LONG
11820     DIM FL_I AS LONGINT
11830     DIM S_CODE(0 TO 512 - 1) AS BYTE
11840     DIM V_CODE AS BYTE PTR = @S_CODE(0)
11850     DIM S_ORIGINAL(0 TO 32 - 1) AS BYTE
11860     DIM V_ORIGINAL AS BYTE PTR = @S_ORIGINAL(0)
11870     DIM V_DECODER AS ANY PTR
11880     DIM V_DECODED AS INSTRUCTION
11890     DIM V_DISPLACEMENT AS LONGINT
11900     DIM V_INSTRUCTION_WORD AS LONGINT
11910     DIM V_OLD_DISPLACEMENT AS LONGINT
11920     DIM V_IMMEDIATE AS LONGINT
11930     DIM V_ORIGINAL_PC AS LONGINT
11940     DIM V_REPLAY_PC AS LONGINT
11950     DIM V_REPLAY_OFFSET AS LONG
11960     DIM V_POSITION AS LONG
11970     DIM V_STOLEN_BYTES AS LONG
11980     DIM V_N AS LONG
11990     DIM V_J AS LONG
12000     DIM V_K AS LONG
12010     DIM V_ARGUMENT_REGISTER AS LONG
12020     DIM S_BRANCH_OFFSETS(0 TO 8 - 1) AS LONG
12030     DIM V_BRANCH_OFFSETS AS LONG PTR = @S_BRANCH_OFFSETS(0)
12040     DIM V_BRANCH_COUNT AS LONG
12050     DIM V_SIGNATURE AS STRING = "LUMINA" & CHR(0)
12060     DIM V_OK AS LONG
12070     V_OK = 0
12080     V_CODE_SIZE = 0
12090     V_PATCH_SIZE = 0
12100     FOR FL_I = 1 TO (512 + 1 - 1)
12110         V_OUTPUT[FL_I - 1] = 0
12120     NEXT
12130     FOR FL_I = 1 TO (32 + 1 - 1)
12140         V_PATCH[FL_I - 1] = 0
12150     NEXT
12160     FOR FL_I = 1 TO (512 + 1 - 1)
12170         V_CODE[FL_I - 1] = 0
12180     NEXT
12190     IF V_ARCH <> 1  ANDALSO  V_ARCH <> 2 THEN
12200         RETURN V_OK
12210     END IF
12220     IF V_ABI <> 0  ANDALSO  V_ABI <> 1 THEN
12230         RETURN V_OK
12240     END IF
12250     IF V_ADDRESS <= 0  ORELSE  V_TRAMPOLINE <= 0 THEN
12260         RETURN V_OK
12270     END IF
12280     IF V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - 512  ORELSE   V_TRAMPOLINE > &H7FFFFFFFFFFFFFFFLL - 512 THEN
12290         RETURN V_OK
12300     END IF
12310     V_DISPLACEMENT = V_TRAMPOLINE - V_ADDRESS
12320     IF V_ARCH = 1  ANDALSO   NOT  F_FITS_SIGNED(V_DISPLACEMENT, 32) THEN
12330         RETURN V_OK
12340     END IF
12350     IF V_ARCH = 2  ANDALSO   NOT  F_FITS_SIGNED(V_DISPLACEMENT, 28) THEN
12360         RETURN V_OK
12370     END IF
12380     V_N = CLNGINT(FL_MIN(V_INPUT_SIZE, 32LL))
12390     IF V_N < 4  ORELSE  (V_ARCH = 1  ANDALSO  V_N < 5) THEN
12400         RETURN V_OK
12410     END IF
12420     MEMCPY((@V_ORIGINAL[0]), (@V_INPUT[0]), ((V_N) - (1) + 1) * SIZEOF(BYTE))
12430     IF V_ARCH = 1 THEN
12440         V_ARGUMENT_REGISTER = IIF(V_ABI = 1, 1, (7))
12450         V_CODE[1 + 0 - 1] = F_BYTE_AT(72LL)
12460         V_CODE[1 + 1 - 1] = F_BYTE_AT(133LL)
12470         V_CODE[1 + 2 - 1] = F_BYTE_AT(CLNGINT(192 + 9*V_ARGUMENT_REGISTER))
12480         V_CODE[4 + 0 - 1] = F_BYTE_AT(15LL)
12490         V_CODE[4 + 1 - 1] = F_BYTE_AT(132LL)
12500         V_BRANCH_OFFSETS[0] = 6
12510         V_BRANCH_COUNT = 1
12520         V_POSITION = 10
12530         FOR V_K = 0 TO 6
12540             V_CODE[V_POSITION + 0 - 1] = F_BYTE_AT(128LL)
12550             V_CODE[V_POSITION + 1 - 1] = F_BYTE_AT(CLNGINT(120 + V_ARGUMENT_REGISTER))
12560             V_CODE[V_POSITION + 2 - 1] = F_BYTE_AT(CLNGINT(V_K))
12570             V_CODE[V_POSITION + 3 - 1] = F_BYTE_AT(CLNGINT(ASC(MID(V_SIGNATURE, V_K + 1, (V_K + 1) - (V_K + 1) + 1))))
12580             V_CODE[V_POSITION + 4 + 0 - 1] = F_BYTE_AT(15LL)
12590             V_CODE[V_POSITION + 4 + 1 - 1] = F_BYTE_AT(133LL)
12600             V_BRANCH_COUNT = V_BRANCH_COUNT + 1
12610             V_BRANCH_OFFSETS[V_BRANCH_COUNT - 1] = V_POSITION + 6
12620             V_POSITION = V_POSITION + 10
12630         NEXT
12640         V_CODE[V_POSITION + 0 - 1] = F_BYTE_AT(184LL)
12650         V_CODE[V_POSITION + 1 - 1] = 1LL
12660         V_CODE[V_POSITION + 2 - 1] = 0LL
12670         V_CODE[V_POSITION + 3 - 1] = 0LL
12680         V_CODE[V_POSITION + 4 - 1] = 0LL
12690         V_CODE[V_POSITION + 5 - 1] = F_BYTE_AT(195LL)
12700         V_POSITION = V_POSITION + 6
12710         V_REPLAY_OFFSET = V_POSITION - 1
12720         FOR V_K = 1 TO V_BRANCH_COUNT
12730             V_J = V_BRANCH_OFFSETS[V_K - 1]
12740             F_STORE_LE((@V_CODE[V_J - 1]), ((512 + 1 - 1) - (V_J) + 1), CLNGINT(V_REPLAY_OFFSET - (V_J - 1 + 4)), 4)
12750         NEXT
12760     ELSE
12770         IF (V_ADDRESS MOD (4LL)) <> 0  ORELSE   (V_TRAMPOLINE MOD (4LL)) <> 0 THEN
12780             RETURN V_OK
12790         END IF
12800         V_REPLAY_OFFSET = 96
12810         F_STORE_LE(V_CODE, 512, CLNGINT(&HB4000000ULL) +  (CLNGINT(V_REPLAY_OFFSET\4) SHL (5)), 4)
12820         V_POSITION = 5
12830         FOR V_K = 0 TO 6
12840             F_STORE_LE((@V_CODE[V_POSITION - 1]), ((512 + 1 - 1) - (V_POSITION) + 1), (CLNGINT(&H39400010ULL) OR ((CLNGINT(V_K) SHL (10)))), 4)
12850             F_STORE_LE((@V_CODE[V_POSITION + 4 - 1]), ((512 + 1 - 1) - (V_POSITION + 4) + 1), (CLNGINT(&H7100021FULL) OR ((CLNGINT(ASC(MID(V_SIGNATURE, V_K + 1, (V_K + 1) - (V_K + 1) + 1))) SHL (10)))), 4)
12860             V_DISPLACEMENT = V_REPLAY_OFFSET - (V_POSITION - 1 + 8)
12870             F_STORE_LE((@V_CODE[V_POSITION + 8 - 1]), ((512 + 1 - 1) - (V_POSITION + 8) + 1), (CLNGINT(&H54000001ULL) OR ((V_DISPLACEMENT\4 SHL (5)))), 4)
12880             V_POSITION = V_POSITION + 12
12890         NEXT
12900         F_STORE_LE((@V_CODE[V_POSITION - 1]), ((512 + 1 - 1) - (V_POSITION) + 1), CLNGINT(&H52800020ULL), 4)
12910         F_STORE_LE((@V_CODE[V_POSITION + 4 - 1]), ((512 + 1 - 1) - (V_POSITION + 4) + 1), CLNGINT(&HD65F03C0ULL), 4)
12920     END IF
12930     V_DECODER = FL_DECODER_OPEN(V_ARCH)
12940     IF  NOT  (V_DECODER <> 0) THEN
12950         RETURN V_OK
12960     END IF
12970     V_STOLEN_BYTES = 0
12980     WHILE (V_STOLEN_BYTES < IIF(V_ARCH = 1, 5, (4)))
12990         IF V_STOLEN_BYTES >= V_N THEN
13000             EXIT WHILE
13010         END IF
13020         IF FL_DECODE(V_DECODER, @(V_ORIGINAL[V_STOLEN_BYTES + 1 - 1]), CLNGINT(V_N - V_STOLEN_BYTES), V_ADDRESS + V_STOLEN_BYTES, V_DECODED) = 0 THEN
13030             EXIT WHILE
13040         END IF
13050         IF V_DECODED.SIZE <= 0  ORELSE   V_STOLEN_BYTES + V_DECODED.SIZE > V_N THEN
13060             EXIT WHILE
13070         END IF
13080         IF V_DECODED.UNSAFE <> 0 THEN
13090             EXIT WHILE
13100         END IF
13110         IF V_DECODED.KIND >= 6 THEN
13120             IF V_ARCH <> 1  ORELSE  V_DECODED.KIND <> 6  ORELSE   V_DECODED.RELATIVE <> 2 THEN
13130                 EXIT WHILE
13140             END IF
13150         END IF
13160         V_ORIGINAL_PC = V_ADDRESS + V_STOLEN_BYTES
13170         V_REPLAY_PC = V_TRAMPOLINE + V_REPLAY_OFFSET + V_STOLEN_BYTES
13180         MEMCPY((@V_CODE[V_REPLAY_OFFSET + V_STOLEN_BYTES + 1 - 1]), (@V_ORIGINAL[V_STOLEN_BYTES + 1 - 1]), ((V_REPLAY_OFFSET + V_STOLEN_BYTES + V_DECODED.SIZE) - (V_REPLAY_OFFSET + V_STOLEN_BYTES + 1) + 1) * SIZEOF(BYTE))
13190         IF V_ARCH = 1  ANDALSO  V_DECODED.RELATIVE <> 0 THEN
13200             IF V_DECODED.DISPLACEMENT_SIZE <> 4 THEN
13210                 EXIT WHILE
13220             END IF
13230             V_J = V_STOLEN_BYTES + V_DECODED.DISPLACEMENT_OFFSET + 1
13240             IF V_J < V_STOLEN_BYTES + 1  ORELSE   V_J + 3 > V_STOLEN_BYTES + V_DECODED.SIZE THEN
13250                 EXIT WHILE
13260             END IF
13270             V_OLD_DISPLACEMENT = F_SIGNED_FIELD(F_LOAD_LE((@V_ORIGINAL[V_J - 1]), ((32 + 1 - 1) - (V_J) + 1), 4), 32)
13280             V_DISPLACEMENT = (V_ORIGINAL_PC - V_REPLAY_PC) + V_OLD_DISPLACEMENT
13290             IF  NOT  F_FITS_SIGNED(V_DISPLACEMENT, 32) THEN
13300                 EXIT WHILE
13310             END IF
13320             F_STORE_LE((@V_CODE[V_REPLAY_OFFSET + V_J - 1]), ((512 + 1 - 1) - (V_REPLAY_OFFSET + V_J) + 1), V_DISPLACEMENT, 4)
13330         ELSEIF V_ARCH = 2 THEN
13340             V_INSTRUCTION_WORD = F_LOAD_LE((@V_ORIGINAL[V_STOLEN_BYTES + 1 - 1]), ((32 + 1 - 1) - (V_STOLEN_BYTES + 1) + 1), 4)
13350             IF (V_INSTRUCTION_WORD AND (CLNGINT(&H1F000000ULL))) =  CLNGINT(&H10000000ULL) THEN
13360                 V_IMMEDIATE = F_SIGNED_FIELD(((FL_BITS(V_INSTRUCTION_WORD, 5, 19) SHL (2)) OR (FL_BITS(V_INSTRUCTION_WORD, 29, 2))), 21)
13370                 IF ((V_INSTRUCTION_WORD AND (1ULL SHL 31)) <> 0) THEN
13380                     V_DISPLACEMENT = (CULNGINT(V_ORIGINAL_PC) SHR (12)) + V_IMMEDIATE -  (CULNGINT(V_REPLAY_PC) SHR (12))
13390                 ELSE
13400                     V_DISPLACEMENT = (V_ORIGINAL_PC - V_REPLAY_PC) + V_IMMEDIATE
13410                 END IF
13420                 IF  NOT  F_FITS_SIGNED(V_DISPLACEMENT, 21) THEN
13430                     EXIT WHILE
13440                 END IF
13450                 V_INSTRUCTION_WORD = ((V_INSTRUCTION_WORD AND (CLNGINT(&H9F00001FULL))) OR (((FL_BITS(V_DISPLACEMENT, 0, 2) SHL (29)) OR ((FL_BITS(V_DISPLACEMENT, 2, 19) SHL (5))))))
13460             ELSEIF (V_INSTRUCTION_WORD AND (CLNGINT(&H3B000000ULL))) =  CLNGINT(&H18000000ULL) THEN
13470                 V_DISPLACEMENT = (V_ORIGINAL_PC - V_REPLAY_PC) +  4*F_SIGNED_FIELD(FL_BITS(V_INSTRUCTION_WORD, 5, 19), 19)
13480                 IF (V_DISPLACEMENT MOD (4LL)) <> 0  ORELSE    NOT  F_FITS_SIGNED(V_DISPLACEMENT\4, 19) THEN
13490                     EXIT WHILE
13500                 END IF
13510                 V_INSTRUCTION_WORD = ((V_INSTRUCTION_WORD AND (CLNGINT(&HFF00001FULL))) OR ((FL_BITS(V_DISPLACEMENT\4, 0, 19) SHL (5))))
13520             END IF
13530             F_STORE_LE((@V_CODE[V_REPLAY_OFFSET + V_STOLEN_BYTES + 1 - 1]), ((512 + 1 - 1) - (V_REPLAY_OFFSET + V_STOLEN_BYTES + 1) + 1), V_INSTRUCTION_WORD, 4)
13540         END IF
13550         V_STOLEN_BYTES = V_STOLEN_BYTES + V_DECODED.SIZE
13560     WEND
13570     FL_DECODER_CLOSE(V_DECODER)
13580     IF V_STOLEN_BYTES < IIF(V_ARCH = 1, 5, (4)) THEN
13590         RETURN V_OK
13600     END IF
13610     IF V_ARCH = 1 THEN
13620         V_DISPLACEMENT = V_TRAMPOLINE - (V_ADDRESS + 5)
13630         IF  NOT  F_FITS_SIGNED(V_DISPLACEMENT, 32) THEN
13640             RETURN V_OK
13650         END IF
13660         FOR FL_I = 1 TO (32 + 1 - 1)
13670             V_PATCH[FL_I - 1] = F_BYTE_AT(144LL)
13680         NEXT
13690         V_PATCH[0] = F_BYTE_AT(233LL)
13700         F_STORE_LE((@V_PATCH[2 - 1]), ((32 + 1 - 1) - (2) + 1), V_DISPLACEMENT, 4)
13710         V_POSITION = V_REPLAY_OFFSET + V_STOLEN_BYTES + 1
13720         V_DISPLACEMENT = V_ADDRESS + V_STOLEN_BYTES -  (V_TRAMPOLINE + V_POSITION - 1 + 5)
13730         IF  NOT  F_FITS_SIGNED(V_DISPLACEMENT, 32) THEN
13740             RETURN V_OK
13750         END IF
13760         V_CODE[V_POSITION - 1] = F_BYTE_AT(233LL)
13770         F_STORE_LE((@V_CODE[V_POSITION + 1 - 1]), ((512 + 1 - 1) - (V_POSITION + 1) + 1), V_DISPLACEMENT, 4)
13780         V_CODE_SIZE = V_POSITION - 1 + 5
13790     ELSE
13800         V_DISPLACEMENT = V_TRAMPOLINE - V_ADDRESS
13810         IF (V_DISPLACEMENT MOD (4LL)) <> 0  ORELSE    NOT  F_FITS_SIGNED(V_DISPLACEMENT\4, 26) THEN
13820             RETURN V_OK
13830         END IF
13840         F_STORE_LE(V_PATCH, 32, (CLNGINT(&H14000000ULL) OR (FL_BITS(V_DISPLACEMENT\4, 0, 26))), 4)
13850         V_POSITION = V_REPLAY_OFFSET + V_STOLEN_BYTES + 1
13860         V_DISPLACEMENT = V_ADDRESS + V_STOLEN_BYTES -  (V_TRAMPOLINE + V_POSITION - 1)
13870         IF (V_DISPLACEMENT MOD (4LL)) <> 0  ORELSE    NOT  F_FITS_SIGNED(V_DISPLACEMENT\4, 26) THEN
13880             RETURN V_OK
13890         END IF
13900         F_STORE_LE((@V_CODE[V_POSITION - 1]), ((512 + 1 - 1) - (V_POSITION) + 1), (CLNGINT(&H14000000ULL) OR (FL_BITS(V_DISPLACEMENT\4, 0, 26))), 4)
13910         V_CODE_SIZE = V_POSITION - 1 + 4
13920     END IF
13930     MEMCPY((@V_OUTPUT[0]), V_CODE, (((512 + 1 - 1)) - (1) + 1) * SIZEOF(BYTE))
13940     V_PATCH_SIZE = V_STOLEN_BYTES
13950     V_OK = 1
13960     RETURN V_OK
13970 END FUNCTION
