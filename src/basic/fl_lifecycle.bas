20570 REM INSTALL ONCE AND RESTORE ORIGINAL BYTES ON SHUTDOWN
#INCLUDE ONCE "core.bi"
20580 DIM SHARED S_SAVED_BYTES(0 TO 32 - 1) AS BYTE
20590 DIM SHARED V_SAVED_BYTES AS BYTE PTR = @S_SAVED_BYTES(0)
20600 DIM SHARED S_INSTALLED_BYTES(0 TO 32 - 1) AS BYTE
20610 DIM SHARED V_INSTALLED_BYTES AS BYTE PTR = @S_INSTALLED_BYTES(0)
20620 DIM SHARED V_ENTRY_ADDRESS AS LONGINT = 0
20630 DIM SHARED V_PATCH_LENGTH AS LONG = 0
20640 DIM SHARED G_TRAMPOLINE AS ANY PTR = 0
20650 DIM SHARED V_INSTALLED AS LONG = 0
20660 DIM SHARED V_HEALTHY AS LONG = 0
20670 DIM SHARED V_RETIRED AS LONG = 0
20680 CONST V_ALLOCATION_SIZE = 4096

20690 FUNCTION FL_BASIC_START CDECL ALIAS "fl_basic_start"() AS LONG
20700     DIM V_MEMORY AS ANY PTR
20710     DIM V_ALLOCATION AS ANY PTR
20720     DIM V_REGIONS AS REGION PTR
20730     DIM N_REGIONS AS LONGINT
20740     DIM V_FOUND AS RESULT
20750     DIM S_ORIGINAL(0 TO 32 - 1) AS BYTE
20760     DIM V_ORIGINAL AS BYTE PTR = @S_ORIGINAL(0)
20770     DIM S_CODE(0 TO 512 - 1) AS BYTE
20780     DIM V_CODE AS BYTE PTR = @S_CODE(0)
20790     DIM S_PATCH(0 TO 32 - 1) AS BYTE
20800     DIM V_PATCH AS BYTE PTR = @S_PATCH(0)
20810     DIM V_COUNT AS LONG
20820     DIM V_ARCH AS LONG
20830     DIM V_ABI AS LONG
20840     DIM V_CODE_SIZE AS LONG
20850     DIM V_PATCH_SIZE AS LONG
20860     DIM V_STATE AS LONG
20870     DIM V_ADDRESS AS LONGINT
20880     DIM V_EXPORTED AS LONGINT
20890     DIM V_LICENSE AS LONGINT
20900     DIM V_READ_SIZE AS LONG
20910     DIM V_MESSAGE AS STRING
20920     DIM V_DESTINATION AS BYTE PTR
20930     DIM N_DESTINATION AS LONGINT
20940     DIM V_OK AS LONG
20950     V_OK = 0
20960     IF V_INSTALLED THEN
20970         V_OK = IIF(V_HEALTHY, 1, (0))
20980         RETURN V_OK
20990     END IF
21000     IF V_RETIRED THEN
21010         FL_LOG("lifecycle already retired; restart the host to reinstall" &   CHR(0))
21020         RETURN V_OK
21030     END IF
21040     V_ARCH = FL_NATIVE_ARCH()
21050     V_ABI = FL_NATIVE_ABI()
21060     V_EXPORTED = CLNGINT(FL_SYMBOL("has_valid_add_on" & CHR(0)))
21070     V_LICENSE = CLNGINT(FL_SYMBOL("is_license_valid" & CHR(0)))
21080     IF FL_SNAPSHOT(V_MEMORY, V_COUNT) = 0 THEN
21090         FL_LOG("module snapshot failed; no patch" & CHR(0))
21100         RETURN V_OK
21110     END IF
21120     V_REGIONS = CAST(REGION PTR, V_MEMORY)
21130     N_REGIONS = V_COUNT
21140     FL_ANALYZE(V_ARCH, V_ABI, V_REGIONS, V_COUNT, V_EXPORTED, V_LICENSE, V_FOUND)
21150     FL_SNAPSHOT_FREE(V_MEMORY, V_COUNT)
21160     V_MESSAGE = "discovery status=" & STR(V_FOUND.STATUS) & " candidates=" & STR(V_FOUND.CANDIDATES) & " references=" & STR(V_FOUND.REFERENCES) & " reason=" & STR(V_FOUND.REASON)
21170     FL_LOG(TRIM(V_MESSAGE) & CHR(0))
21180     IF V_FOUND.STATUS = 0 THEN
21190         RETURN V_OK
21200     END IF
21210     V_ADDRESS = V_FOUND.TARGET
21220     IF FL_READ(V_ADDRESS, V_ORIGINAL, 4LL) = 0 THEN
21230         RETURN V_OK
21240     END IF
21250     IF V_ARCH = 1 THEN
21260         IF F_LOAD_LE(V_ORIGINAL, 32, 4) = CLNGINT(&HFA1E0FF3ULL) THEN
21270             V_ADDRESS = V_ADDRESS + 4
21280         END IF
21290     ELSE
21300         IF (F_LOAD_LE(V_ORIGINAL, 32, 4) AND (CLNGINT(&HFFFFFF1FULL))) =  CLNGINT(&HD503241FULL) THEN
21310             V_ADDRESS = V_ADDRESS + 4
21320         END IF
21330     END IF
21340     V_READ_SIZE = 32
21350     WHILE (V_READ_SIZE >= 4)
21360         IF FL_READ(V_ADDRESS, V_ORIGINAL, CLNGINT(V_READ_SIZE)) <> 0 THEN
21370             EXIT WHILE
21380         END IF
21390         V_READ_SIZE = V_READ_SIZE - 1
21400     WEND
21410     IF V_READ_SIZE < 4 THEN
21420         RETURN V_OK
21430     END IF
21440     V_ALLOCATION = FL_ALLOCATE_NEAR(V_ADDRESS, V_ALLOCATION_SIZE)
21450     IF  NOT  (V_ALLOCATION <> 0) THEN
21460         FL_LOG("near executable allocation unavailable; no patch" &   CHR(0))
21470         RETURN V_OK
21480     END IF
21490     IF FL_PLAN(V_ARCH, V_ABI, V_ORIGINAL, CLNGINT(V_READ_SIZE), V_ADDRESS, CLNGINT(V_ALLOCATION), V_CODE, V_CODE_SIZE, V_PATCH, V_PATCH_SIZE) = 0 THEN
21500         FL_RELEASE(V_ALLOCATION, V_ALLOCATION_SIZE)
21510         FL_LOG("unsupported entry instructions or branch range; no patch" &   CHR(0))
21520         RETURN V_OK
21530     END IF
21540     V_DESTINATION = CAST(BYTE PTR, V_ALLOCATION)
21550     N_DESTINATION = V_CODE_SIZE
21560     MEMCPY((@V_DESTINATION[0]), (@V_CODE[0]), (((N_DESTINATION + 1 - 1)) - (1) + 1) * SIZEOF(BYTE))
21570     IF FL_SEAL(V_ALLOCATION, V_ALLOCATION_SIZE) = 0 THEN
21580         FL_RELEASE(V_ALLOCATION, V_ALLOCATION_SIZE)
21590         FL_LOG("executable protection rejected; no patch" & CHR(0))
21600         RETURN V_OK
21610     END IF
21620     V_STATE = FL_EXCHANGE(V_ADDRESS, V_ORIGINAL, V_PATCH, CLNGINT(V_PATCH_SIZE))
21630     IF V_STATE = 0 THEN
21640         FL_RELEASE(V_ALLOCATION, V_ALLOCATION_SIZE)
21650         FL_LOG("entry changed or protection denied; no patch" & CHR(0))
21660         RETURN V_OK
21670     END IF
21680     G_TRAMPOLINE = V_ALLOCATION
21690     MEMCPY((@V_SAVED_BYTES[0]), V_ORIGINAL, (((32 + 1 - 1)) - (1) + 1) * SIZEOF(BYTE))
21700     MEMCPY((@V_INSTALLED_BYTES[0]), V_PATCH, (((32 + 1 - 1)) - (1) + 1) * SIZEOF(BYTE))
21710     V_ENTRY_ADDRESS = V_ADDRESS
21720     V_PATCH_LENGTH = V_PATCH_SIZE
21730     V_INSTALLED = (-1)
21740     IF V_STATE < 0 THEN
21750         FL_LOG("OS protection restoration failed; retained recovery state" &   CHR(0))
21760         RETURN V_OK
21770     END IF
21780     V_HEALTHY = (-1)
21790     V_MESSAGE = "installed at 0x" & HEX(V_ENTRY_ADDRESS,16) & " (" & STR(V_PATCH_LENGTH) & " bytes); LUMINA only"
21800     FL_LOG(TRIM(V_MESSAGE) & CHR(0))
21810     V_OK = 1
21820     RETURN V_OK
21830 END FUNCTION

21840 FUNCTION FL_BASIC_STOP CDECL ALIAS "fl_basic_stop"() AS LONG
21850     DIM V_STATE AS LONG
21860     DIM S_OBSERVED(0 TO 32 - 1) AS BYTE
21870     DIM V_OBSERVED AS BYTE PTR = @S_OBSERVED(0)
21880     DIM V_OK AS LONG
21890     V_OK = 1
21900     IF  NOT  V_INSTALLED THEN
21910         RETURN V_OK
21920     END IF
21930     V_STATE = FL_EXCHANGE(V_ENTRY_ADDRESS, V_INSTALLED_BYTES, V_SAVED_BYTES, CLNGINT(V_PATCH_LENGTH))
21940     IF V_STATE <> 1 THEN
21950         V_HEALTHY = 0
21960         IF FL_READ(V_ENTRY_ADDRESS, V_OBSERVED, CLNGINT(V_PATCH_LENGTH)) <> 0 THEN
21970             IF (MEMCMP(V_OBSERVED, V_SAVED_BYTES, V_PATCH_LENGTH) = 0)  ANDALSO  V_STATE = 0 THEN
21980                 V_INSTALLED = 0
21990                 V_RETIRED = (-1)
22000                 RETURN V_OK
22010             END IF
22020         END IF
22030         FL_LOG("restore failed or entry owned by another patch; " &   "retained executable allocation" & CHR(0))
22040         V_OK = 0
22050         RETURN V_OK
22060     END IF
22070     V_INSTALLED = 0
22080     V_RETIRED = (-1)
22090     FL_LOG("original bytes and protections restored; replay allocation " &   "retained until process exit" & CHR(0))
22100     RETURN V_OK
22110 END FUNCTION
