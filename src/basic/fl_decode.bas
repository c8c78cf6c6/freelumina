6790         V_DECODED.RELATIVE = 1
6800         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, 4*F_SIGNED_FIELD(FL_BITS(V_WORD, 5, 19), 19))
6810         V_VECTOR = ((V_WORD AND (1ULL SHL 26)) <> 0)
6820         IF  NOT  V_VECTOR  ANDALSO  FL_BITS(V_WORD, 30, 2) <> 3 THEN
6830             F_MARK_WRITE(V_DECODED, V_DESTINATION)
