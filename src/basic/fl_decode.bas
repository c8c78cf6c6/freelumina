7270         IF (V_CATEGORY = CLNGINT(&H0A000000ULL)) ORELSE (V_CATEGORY = CLNGINT(&H0B000000ULL)) ORELSE (V_CATEGORY = CLNGINT(&H12000000ULL)) ORELSE (V_CATEGORY = CLNGINT(&H13000000ULL)) ORELSE (V_CATEGORY = CLNGINT(&H1A000000ULL)) ORELSE (V_CATEGORY = CLNGINT(&H1B000000ULL)) THEN
7280             IF V_DESTINATION <> 31 THEN
7290                 F_MARK_WRITE(V_DECODED, V_DESTINATION)
7300             END IF
7310             IF (V_WORD AND (CLNGINT(&HFFE0FFE0ULL))) = CLNGINT(&HAA0003E0ULL) THEN
7320                 V_DECODED.KIND = 5
7330                 V_DECODED.DST = V_DESTINATION
7340                 V_DECODED.SRC = V_SECOND
7350             END IF
7360         ELSE
7370             RETURN V_SUCCESS
7380         END IF
7390     END IF
7400     V_SUCCESS = 1
