6920             F_MARK_WRITE(V_DECODED, V_SOURCE)
6930         END IF
6940         IF ((V_WORD AND (1ULL SHL 22)) <> 0)  ANDALSO   NOT  ((V_WORD AND (1ULL SHL 26)) <> 0) THEN
6950             F_MARK_WRITE(V_DECODED, V_DESTINATION)
6960             F_MARK_WRITE(V_DECODED, CLNGINT(FL_BITS(V_WORD, 10, 5)))
6970         END IF
6980     ELSEIF (V_WORD AND (CLNGINT(&H3B000000ULL))) = CLNGINT(&H39000000ULL)  ORELSE   (V_WORD AND (CLNGINT(&H3B000000ULL))) = CLNGINT(&H38000000ULL) THEN
6990         V_LOAD = FL_BITS(V_WORD, 22, 2) <> 0
7000         V_VECTOR = ((V_WORD AND (1ULL SHL 26)) <> 0)
7010         V_ELEMENT_SIZE = CLNGINT(FL_BITS(V_WORD, 30, 2))
7020         V_MODE = 0
7030         IF  NOT  ((V_WORD AND (1ULL SHL 24)) <> 0) THEN
7040             V_MODE = CLNGINT(FL_BITS(V_WORD, 10, 2))
7050         END IF
7060         IF V_MODE = 1  ORELSE  V_MODE = 3 THEN
7070             F_MARK_WRITE(V_DECODED, V_SOURCE)
7080         END IF
7090         IF V_LOAD  ANDALSO   NOT  V_VECTOR THEN
7100             F_MARK_WRITE(V_DECODED, V_DESTINATION)
7110         END IF
7120         IF V_LOAD  ANDALSO   NOT  V_VECTOR  ANDALSO  V_ELEMENT_SIZE = 3  ANDALSO   (((V_WORD AND (1ULL SHL 24)) <> 0)  ORELSE  V_MODE = 0)  ANDALSO   NOT  ((V_WORD AND (1ULL SHL 23)) <> 0) THEN
7130             V_DECODED.KIND = 4
7140             V_DECODED.DST = V_DESTINATION
7150             V_DECODED.BASE = V_SOURCE
7160             IF ((V_WORD AND (1ULL SHL 24)) <> 0) THEN
