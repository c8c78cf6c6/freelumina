4860         END IF
4870         IF V_OPCODE = 128  ORELSE  V_OPCODE = 129  ORELSE  V_OPCODE = 131 THEN
4880             IF V_OPERANDS.GROUP = 7 THEN
4890                 V_WRITES_RM = 0
4900             END IF
4910         END IF
4920         IF V_OPCODE = 198  ORELSE  V_OPCODE = 199  ORELSE  V_OPCODE = 143 THEN
4930             IF V_OPERANDS.GROUP <> 0 THEN
4940                 RETURN V_SUCCESS
4950             END IF
4960         END IF
4970         IF V_OPCODE = 141  ANDALSO  V_OPERANDS.MODE = 3 THEN
4980             RETURN V_SUCCESS
4990         END IF
5000         IF V_OPCODE = 246  ORELSE  V_OPCODE = 247 THEN
5010             REM BRANCH ON V_OPERANDS.GROUP
5020             IF (V_OPERANDS.GROUP = 0) THEN
5030                 V_IMMEDIATE_WIDTH = IIF(V_BYTE_OPERAND, 1, (FL_MIN(V_OPERAND_WIDTH, 4)))
5040             ELSEIF (V_OPERANDS.GROUP = 1) THEN
5050                 RETURN V_SUCCESS
5060             ELSEIF (V_OPERANDS.GROUP = 2) ORELSE (V_OPERANDS.GROUP = 3) THEN
5070                 V_WRITES_RM = (-1)
5080             ELSEIF (V_OPERANDS.GROUP >= 4 ANDALSO V_OPERANDS.GROUP <= 7) THEN
5090                 F_MARK_WRITE(V_DECODED, 0)
5100                 F_MARK_WRITE(V_DECODED, 2)
5110             END IF
5120         END IF
5130         IF V_OPCODE = 254 THEN
5140             IF V_OPERANDS.GROUP > 1 THEN
5150                 RETURN V_SUCCESS
5160             END IF
5170             V_WRITES_RM = (-1)
5180         END IF
5190         IF V_OPCODE = 255 THEN
5200             REM BRANCH ON V_OPERANDS.GROUP
5210             IF (V_OPERANDS.GROUP = 0) ORELSE (V_OPERANDS.GROUP = 1) THEN
5220                 V_WRITES_RM = (-1)
5230             ELSEIF (V_OPERANDS.GROUP = 2) ORELSE (V_OPERANDS.GROUP = 4) THEN
5240                 V_DECODED.KIND = IIF(V_OPERANDS.GROUP = 2, 6, (7))
5250                 IF V_OPERANDS.MODE = 3 THEN
5260                     V_DECODED.SRC = V_OPERANDS.SOURCE
5270                 END IF
5280             ELSEIF (V_OPERANDS.GROUP = 6) THEN
5290                 F_MARK_WRITE(V_DECODED, 4)
5300             ELSE
5310                 RETURN V_SUCCESS
5320             END IF
5330         END IF
5340         IF V_WRITES_REG THEN
5350             F_MARK_WRITE(V_DECODED, V_REGISTER)
5360         END IF
5370         IF V_WRITES_RM  ANDALSO  V_OPERANDS.MODE = 3 THEN
5380             F_MARK_WRITE(V_DECODED, V_RM_REGISTER)
5390         END IF
5400         V_DECODED.DISPLACEMENT_OFFSET = V_OPERANDS.DISPLACEMENT_OFFSET
5410         V_DECODED.DISPLACEMENT_SIZE = V_OPERANDS.DISPLACEMENT_SIZE
5420         IF V_OPERANDS.RIP_RELATIVE THEN
5430             V_DECODED.RELATIVE = 1
5440         END IF
5450         IF V_OPCODE = 141  ANDALSO  V_OPERAND_WIDTH = 8  ANDALSO   NOT  V_SEGMENT_OVERRIDE THEN
5460             V_DECODED.DST = V_REGISTER
5470             IF V_OPERANDS.RIP_RELATIVE THEN
5480                 V_DECODED.KIND = 1
5490             ELSEIF V_OPERANDS.BASE >= 0  ANDALSO  V_OPERANDS.INDEX < 0  ANDALSO   NOT  V_ADDRESS32 THEN
5500                 V_DECODED.KIND = 3
5510                 V_DECODED.SRC = V_OPERANDS.BASE
5520                 V_DECODED.IMMEDIATE = V_OPERANDS.DISPLACEMENT
5530             END IF
5540         ELSEIF V_OPCODE = 137  ORELSE  V_OPCODE = 139 THEN
5550             IF V_OPERAND_WIDTH = 8  ANDALSO   NOT  V_SEGMENT_OVERRIDE THEN
5560                 IF V_OPERANDS.MODE = 3 THEN
5570                     V_DECODED.KIND = 5
5580                     V_DECODED.DST = IIF(V_OPCODE = 139, V_REGISTER, (V_RM_REGISTER))
5590                     V_DECODED.SRC = IIF(V_OPCODE = 139, V_RM_REGISTER, (V_REGISTER))
5600                 ELSEIF V_OPCODE = 139  ANDALSO  V_OPERANDS.INDEX < 0  ANDALSO   NOT  V_ADDRESS32 THEN
5610                     V_DECODED.KIND = 4
5620                     V_DECODED.DST = V_REGISTER
5630                     V_DECODED.BASE = V_OPERANDS.BASE
5640                     V_DECODED.INDEX = V_OPERANDS.INDEX
5650                     V_DECODED.IMMEDIATE = V_OPERANDS.DISPLACEMENT
5660                 END IF
5670             END IF
5680         END IF
5690         IF V_OPCODE = 15  ANDALSO  V_SECOND = 30 THEN
5700             IF  NOT  V_PREFIX_REPEAT  ORELSE  V_OPERANDS.MODE <> 3  ORELSE   V_OPERANDS.GROUP <> 7  ORELSE  V_OPERANDS.SOURCE <> 2 THEN
5710                 RETURN V_SUCCESS
5720             END IF
5730         END IF
5740     END IF
5750     IF V_BRANCH_WIDTH > 0 THEN
5760         V_DECODED.DISPLACEMENT_OFFSET = V_POSITION - 1
5770         V_DECODED.DISPLACEMENT_SIZE = V_BRANCH_WIDTH
5780         IF  NOT  F_CONSUME(V_BYTES, N_BYTES, V_POSITION, V_BRANCH_WIDTH, V_FIELD) THEN
5790             RETURN V_SUCCESS
5800         END IF
5810         V_DECODED.RELATIVE = 2
5820         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS + V_POSITION - 1, F_SIGNED_FIELD(V_FIELD, 8*V_BRANCH_WIDTH))
5830         IF V_DECODED.KIND = 6  ANDALSO  V_FIELD = 0 THEN
5840             V_DECODED.UNSAFE = 1
5850         END IF
5860     ELSEIF V_IMMEDIATE_WIDTH > 0 THEN
5870         IF  NOT  F_CONSUME(V_BYTES, N_BYTES, V_POSITION, V_IMMEDIATE_WIDTH, V_IMMEDIATE) THEN
5880             RETURN V_SUCCESS
5890         END IF
5900         IF V_OPCODE >= 184  ANDALSO  V_OPCODE <= 191  ANDALSO  V_OPERAND_WIDTH >= 4 THEN
5910             V_DECODED.KIND = 1
5920             V_DECODED.TARGET = V_IMMEDIATE
5930         END IF
5940     END IF
5950     V_WIDTH = V_POSITION - 1
5960     IF V_WIDTH > 15 THEN
5970         RETURN V_SUCCESS
5980     END IF
5990     V_DECODED.SIZE = V_WIDTH
6000     IF V_OPERANDS.RIP_RELATIVE  ANDALSO  V_HAS_MODRM THEN
6010         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS + V_WIDTH, V_OPERANDS.DISPLACEMENT)
6020         IF V_ADDRESS32 THEN
6030             V_DECODED.TARGET = (V_DECODED.TARGET AND (CLNGINT(&HFFFFFFFFULL)))
6040             V_DECODED.UNSAFE = 1
6050         END IF
6060     END IF
6070     V_SUCCESS = 1
6080     RETURN V_SUCCESS
6090 END FUNCTION

6100 FUNCTION F_DECODE_ARM64 CDECL(BYVAL V_BYTES AS BYTE PTR, BYVAL N_BYTES AS LONGINT, BYREF V_DECODED AS INSTRUCTION) AS LONG
6110     DIM V_WORD AS LONGINT
6120     DIM V_IMMEDIATE AS LONGINT
6130     DIM V_CATEGORY AS LONGINT
6140     DIM V_DESTINATION AS LONG
6150     DIM V_SOURCE AS LONG
6160     DIM V_SECOND AS LONG
6170     DIM V_MODE AS LONG
6180     DIM V_ELEMENT_SIZE AS LONG
6190     DIM V_LOAD AS LONG
6200     DIM V_VECTOR AS LONG
6210     DIM V_SUCCESS AS LONG
6220     V_SUCCESS = 0
6230     V_WORD = F_LOAD_LE(V_BYTES, N_BYTES, 4)
6240     V_DESTINATION = CLNGINT(FL_BITS(V_WORD, 0, 5))
6250     V_SOURCE = CLNGINT(FL_BITS(V_WORD, 5, 5))
6260     V_SECOND = CLNGINT(FL_BITS(V_WORD, 16, 5))
6270     V_DECODED.SIZE = 4
6280     IF (V_WORD AND (CLNGINT(&H7C000000ULL))) = CLNGINT(&H14000000ULL) THEN
6290         V_DECODED.KIND = IIF(((V_WORD AND (1ULL SHL 31)) <> 0), 6, (7))
6300         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, 4*F_SIGNED_FIELD(FL_BITS(V_WORD, 0, 26), 26))
6310         V_DECODED.RELATIVE = 2
6320     ELSEIF (V_WORD AND (CLNGINT(&HFF000010ULL))) = CLNGINT(&H54000000ULL) THEN
6330         V_DECODED.KIND = 9
6340         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, 4*F_SIGNED_FIELD(FL_BITS(V_WORD, 5, 19), 19))
6350         V_DECODED.RELATIVE = 2
6360     ELSEIF (V_WORD AND (CLNGINT(&H7E000000ULL))) = CLNGINT(&H34000000ULL) THEN
6370         V_DECODED.KIND = 9
6380         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, 4*F_SIGNED_FIELD(FL_BITS(V_WORD, 5, 19), 19))
6390         V_DECODED.RELATIVE = 2
6400     ELSEIF (V_WORD AND (CLNGINT(&H7E000000ULL))) = CLNGINT(&H36000000ULL) THEN
6410         V_DECODED.KIND = 9
6420         V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, 4*F_SIGNED_FIELD(FL_BITS(V_WORD, 5, 14), 14))
6430         V_DECODED.RELATIVE = 2
6440     ELSEIF (V_WORD AND (CLNGINT(&HFFFFFC1FULL))) = CLNGINT(&HD61F0000ULL) THEN
6450         V_DECODED.KIND = 7
6460         V_DECODED.SRC = V_SOURCE
6470     ELSEIF (V_WORD AND (CLNGINT(&HFFFFFC1FULL))) = CLNGINT(&HD63F0000ULL) THEN
6480         V_DECODED.KIND = 6
6490         V_DECODED.SRC = V_SOURCE
6500     ELSEIF (V_WORD AND (CLNGINT(&HFFFFFC1FULL))) = CLNGINT(&HD65F0000ULL) THEN
6510         V_DECODED.KIND = 8
6520     ELSEIF (V_WORD AND (CLNGINT(&H1F000000ULL))) = CLNGINT(&H10000000ULL) THEN
6530         V_IMMEDIATE = F_SIGNED_FIELD(((FL_BITS(V_WORD, 5, 19) SHL (2)) OR (FL_BITS(V_WORD, 29, 2))), 21)
6540         V_DECODED.DST = V_DESTINATION
6550         V_DECODED.RELATIVE = 1
6560         IF ((V_WORD AND (1ULL SHL 31)) <> 0) THEN
6570             V_DECODED.KIND = 2
6580             V_DECODED.TARGET = F_ADDRESS_SUM((V_DECODED.ADDRESS AND ((NOT (4095LL)))), 4096*V_IMMEDIATE)
6590         ELSE
6600             V_DECODED.KIND = 1
6610             V_DECODED.TARGET = F_ADDRESS_SUM(V_DECODED.ADDRESS, V_IMMEDIATE)
6620         END IF
6630         F_MARK_WRITE(V_DECODED, V_DESTINATION)
6640     ELSEIF (V_WORD AND (CLNGINT(&H1F000000ULL))) = CLNGINT(&H11000000ULL) THEN
6650         V_IMMEDIATE = FL_BITS(V_WORD, 10, 12)
6660         IF ((V_WORD AND (1ULL SHL 22)) <> 0) THEN
6670             V_IMMEDIATE = (V_IMMEDIATE SHL (12))
6680         END IF
6690         IF ((V_WORD AND (1ULL SHL 31)) <> 0)  ANDALSO   NOT  ((V_WORD AND (1ULL SHL 30)) <> 0)  ANDALSO   NOT  ((V_WORD AND (1ULL SHL 29)) <> 0) THEN
6700             V_DECODED.KIND = 3
6710             V_DECODED.DST = V_DESTINATION
6720             V_DECODED.SRC = V_SOURCE
6730             V_DECODED.IMMEDIATE = V_IMMEDIATE
