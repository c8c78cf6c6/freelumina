20 REM BINARY FIELD AND SEARCH HELPERS
#INCLUDE ONCE "core.bi"
30 FUNCTION FL_MASK(BYVAL BITS AS LONG) AS ULONGINT
40     IF BITS >= 64 THEN RETURN NOT 0ULL
50     IF BITS <= 0 THEN RETURN 0
60     RETURN (1ULL SHL BITS) - 1
70 END FUNCTION
80 FUNCTION FL_BITS(BYVAL VALUE AS ULONGINT, BYVAL FIRST AS LONG, BYVAL COUNT AS LONG) AS LONGINT
90     RETURN (VALUE SHR FIRST) AND FL_MASK(COUNT)
100 END FUNCTION
110 FUNCTION FL_CONTAINS(BYVAL VALUES AS LONGINT PTR, BYVAL COUNT AS LONGINT, BYVAL VALUE AS LONGINT) AS LONG
120     FOR K AS LONGINT = 0 TO COUNT - 1
130         IF VALUES[K] = VALUE THEN RETURN -1
140     NEXT
150     RETURN 0
160 END FUNCTION
