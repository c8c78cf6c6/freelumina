7430 REM FIND THE UNIQUE TARGET IN OWNED MEMORY SNAPSHOTS
#INCLUDE ONCE "core.bi"
7440 CONST V_CANDIDATE_LIMIT = 1024

7450 FUNCTION F_VIEW CDECL(BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT, BYVAL V_LENGTH AS LONGINT, BYVAL V_EXECUTABLE_ONLY AS LONG) AS ANY PTR
7460     DIM V_POINTER AS ANY PTR
7470     DIM V_BYTES AS BYTE PTR
7480     DIM N_BYTES AS LONGINT
7490     DIM V_K AS LONG
7500     DIM V_OFFSET AS LONGINT
7510     V_POINTER = 0
7520     IF V_ADDRESS < 0  ORELSE  V_LENGTH <= 0 THEN
7530         RETURN V_POINTER
7540     END IF
7550     FOR V_K = 1 TO N_REGIONS
7560         IF V_EXECUTABLE_ONLY  ANDALSO  V_REGIONS[V_K - 1].EXECUTABLE = 0 THEN
7570             CONTINUE FOR
7580         END IF
7590         IF V_ADDRESS < V_REGIONS[V_K - 1].ADDRESS THEN
7600             CONTINUE FOR
7610         END IF
7620         V_OFFSET = V_ADDRESS - V_REGIONS[V_K - 1].ADDRESS
7630         IF V_LENGTH > V_REGIONS[V_K - 1].SIZE THEN
7640             CONTINUE FOR
7650         END IF
7660         IF V_OFFSET > V_REGIONS[V_K - 1].SIZE - V_LENGTH THEN
7670             CONTINUE FOR
7680         END IF
7690         IF  NOT  (V_REGIONS[V_K - 1].BYTES <> 0) THEN
7700             CONTINUE FOR
7710         END IF
7720         V_BYTES = CAST(BYTE PTR, V_REGIONS[V_K - 1].BYTES)
7730         N_BYTES = V_REGIONS[V_K - 1].SIZE
7740         V_POINTER = @(V_BYTES[V_OFFSET + 1 - 1])
7750         RETURN V_POINTER
7760     NEXT
7770     RETURN V_POINTER
7780 END FUNCTION

7790 FUNCTION F_POINTER_AT CDECL(BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT) AS LONGINT
7800     DIM V_POINTER AS ANY PTR
7810     DIM V_BYTES AS BYTE PTR
7820     DIM N_BYTES AS LONGINT
7830     DIM V_VALUE AS LONGINT
7840     V_VALUE = 0
7850     V_POINTER = F_VIEW(V_REGIONS, N_REGIONS, V_ADDRESS, 8LL, 0)
7860     IF  NOT  (V_POINTER <> 0) THEN
7870         RETURN V_VALUE
7880     END IF
7890     V_BYTES = CAST(BYTE PTR, V_POINTER)
7900     N_BYTES = 8
7910     V_VALUE = F_LOAD_LE(V_BYTES, N_BYTES, 8)
7920     RETURN V_VALUE
7930 END FUNCTION

7940 FUNCTION F_IS_TARGET CDECL(BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT) AS LONG
7950     DIM V_POINTER AS ANY PTR
7960     DIM V_BYTES AS BYTE PTR
7970     DIM N_BYTES AS LONGINT
7980     DIM V_K AS LONG
7990     DIM V_LITERAL AS STRING = "LUMINA" & CHR(0)
8000     DIM V_FOUND AS LONG
8010     V_FOUND = 0
8020     V_POINTER = F_VIEW(V_REGIONS, N_REGIONS, V_ADDRESS, 7LL, 0)
8030     IF  NOT  (V_POINTER <> 0) THEN
8040         RETURN V_FOUND
8050     END IF
8060     V_BYTES = CAST(BYTE PTR, V_POINTER)
8070     N_BYTES = 7
8080     FOR V_K = 1 TO 7
8090         IF F_BYTE_VALUE(V_BYTES[V_K - 1]) <> ASC(MID(V_LITERAL, V_K, (V_K) - (V_K) + 1)) THEN
8100             RETURN V_FOUND
8110         END IF
8120     NEXT
8130     V_FOUND = (-1)
8140     RETURN V_FOUND
8150 END FUNCTION

8160 FUNCTION F_INSTRUCTION_AT CDECL(BYVAL V_DECODER AS ANY PTR, BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT, BYREF V_DECODED AS INSTRUCTION) AS LONG
8170     DIM V_OK AS LONG
8180     DIM V_POINTER AS ANY PTR
8190     DIM V_SIZE AS LONG
8200     V_OK = 0
8210     FOR V_SIZE = 15 TO 1 STEP -1
8220         V_POINTER = F_VIEW(V_REGIONS, N_REGIONS, V_ADDRESS, CLNGINT(V_SIZE), (-1))
8230         IF  NOT  (V_POINTER <> 0) THEN
8240             CONTINUE FOR
8250         END IF
8260         V_OK = FL_DECODE(V_DECODER, V_POINTER, CLNGINT(V_SIZE), V_ADDRESS, V_DECODED)
8270         RETURN V_OK
8280     NEXT
8290     RETURN V_OK
8300 END FUNCTION

8310 FUNCTION F_RESOLVE CDECL(BYVAL V_DECODER AS ANY PTR, BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT) AS LONGINT
8320     DIM FL_I AS LONGINT
8330     DIM S_VISITED(0 TO 8 - 1) AS LONGINT
8340     DIM V_VISITED AS LONGINT PTR = @S_VISITED(0)
8350     DIM V_NEXT_ADDRESS AS LONGINT
8360     DIM S_REGISTER_FILE(0 TO (31 - 0 + 1) - 1) AS LONGINT
8370     DIM V_REGISTER_FILE AS LONGINT PTR = @S_REGISTER_FILE(0)
8380     DIM V_DECODED AS INSTRUCTION
8390     DIM V_K AS LONG
8400     DIM V_J AS LONG
8410     DIM V_DESTINATION AS LONG
8420     DIM V_VALUE AS LONGINT
8430     V_VALUE = V_ADDRESS
8440     FOR V_K = 1 TO 8
8450         IF V_VALUE <= 0 THEN
8460             EXIT FOR
8470         END IF
8480         IF FL_CONTAINS(V_VISITED, V_K - 1, V_VALUE) THEN
8490             EXIT FOR
8500         END IF
8510         V_VISITED[V_K - 1] = V_VALUE
8520         IF F_INSTRUCTION_AT(V_DECODER, V_REGIONS, N_REGIONS, V_VALUE, V_DECODED) = 0 THEN
8530             EXIT FOR
8540         END IF
8550         IF V_DECODED.KIND = 7 THEN
8560             V_NEXT_ADDRESS = V_DECODED.TARGET
8570             IF V_DECODED.RELATIVE = 1 THEN
8580                 V_NEXT_ADDRESS = F_POINTER_AT(V_REGIONS, N_REGIONS, V_NEXT_ADDRESS)
8590             END IF
8600             IF V_NEXT_ADDRESS <= 0 THEN
8610                 EXIT FOR
8620             END IF
8630             V_VALUE = V_NEXT_ADDRESS
8640             CONTINUE FOR
8650         END IF
8660         IF V_DECODED.KIND <> 2  ORELSE  V_DECODED.DST < 0 THEN
8670             RETURN V_VALUE
8680         END IF
8690         FOR FL_I = 0 TO ((31 - 0 + 1) + 0 - 1)
8700             V_REGISTER_FILE[FL_I] = 0
8710         NEXT
8720         V_REGISTER_FILE[V_DECODED.DST] = V_DECODED.TARGET
8730         V_NEXT_ADDRESS = V_VALUE + V_DECODED.SIZE
8740         FOR V_J = 1 TO 3
8750             IF F_INSTRUCTION_AT(V_DECODER, V_REGIONS, N_REGIONS, V_NEXT_ADDRESS, V_DECODED) = 0 THEN
8760                 EXIT FOR
8770             END IF
8780             IF V_DECODED.KIND = 7  ANDALSO  V_DECODED.SRC >= 0 THEN
8790                 IF V_REGISTER_FILE[V_DECODED.SRC] > 0 THEN
8800                     V_VALUE = V_REGISTER_FILE[V_DECODED.SRC]
8810                     EXIT FOR
8820                 END IF
8830             END IF
8840             V_DESTINATION = V_DECODED.DST
8850             IF V_DECODED.KIND <> 4  ORELSE  V_DESTINATION < 0  ORELSE   V_DECODED.BASE < 0  ORELSE  V_DECODED.INDEX >= 0 THEN
8860                 EXIT FOR
8870             END IF
8880             IF V_REGISTER_FILE[V_DECODED.BASE] = 0 THEN
8890                 EXIT FOR
8900             END IF
8910             V_REGISTER_FILE[V_DESTINATION] = F_POINTER_AT(V_REGIONS, N_REGIONS, F_ADDRESS_SUM(V_REGISTER_FILE[V_DECODED.BASE], V_DECODED.IMMEDIATE))
8920             V_NEXT_ADDRESS = V_NEXT_ADDRESS + V_DECODED.SIZE
8930         NEXT
8940         IF V_VALUE = V_VISITED[V_K - 1] THEN
8950             RETURN V_VALUE
8960         END IF
8970     NEXT
8980     V_VALUE = 0
8990     RETURN V_VALUE
9000 END FUNCTION

9010 FUNCTION F_CALLS_LICENSE CDECL(BYVAL V_DECODER AS ANY PTR, BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT, BYVAL V_LICENSE AS LONGINT) AS LONG
9020     DIM S_CANDIDATE_CALLS(0 TO 128 - 1) AS LONGINT
9030     DIM V_CANDIDATE_CALLS AS LONGINT PTR = @S_CANDIDATE_CALLS(0)
9040     DIM S_ANCHOR_CALLS(0 TO 128 - 1) AS LONGINT
9050     DIM V_ANCHOR_CALLS AS LONGINT PTR = @S_ANCHOR_CALLS(0)
9060     DIM V_CANDIDATE_COUNT AS LONG
9070     DIM V_ANCHOR_COUNT AS LONG
9080     DIM V_CANDIDATE_INDEX AS LONG
9090     DIM V_COMPLETE AS LONG
9100     DIM V_FOUND AS LONG
9110     V_FOUND = 0
9120     IF V_LICENSE = 0 THEN
9130         RETURN V_FOUND
9140     END IF
9150     F_COLLECT_CALLS(V_DECODER, V_REGIONS, N_REGIONS, V_ADDRESS, V_CANDIDATE_CALLS, 128, V_CANDIDATE_COUNT, V_COMPLETE)
9160     IF  NOT  V_COMPLETE THEN
9170         RETURN V_FOUND
9180     END IF
9190     IF FL_CONTAINS(V_CANDIDATE_CALLS, V_CANDIDATE_COUNT, V_LICENSE) THEN
9200         V_FOUND = (-1)
9210         RETURN V_FOUND
9220     END IF
9230     F_COLLECT_CALLS(V_DECODER, V_REGIONS, N_REGIONS, V_LICENSE, V_ANCHOR_CALLS, 128, V_ANCHOR_COUNT, V_COMPLETE)
9240     IF  NOT  V_COMPLETE THEN
9250         RETURN V_FOUND
9260     END IF
9270     FOR V_CANDIDATE_INDEX = 1 TO V_CANDIDATE_COUNT
9280         IF FL_CONTAINS(V_ANCHOR_CALLS, V_ANCHOR_COUNT, V_CANDIDATE_CALLS[V_CANDIDATE_INDEX - 1]) THEN
9290             V_FOUND = (-1)
9300             RETURN V_FOUND
9310         END IF
9320     NEXT
9330     RETURN V_FOUND
9340 END FUNCTION

9350 SUB F_COLLECT_CALLS CDECL(BYVAL V_DECODER AS ANY PTR, BYVAL V_REGIONS AS REGION PTR, BYVAL N_REGIONS AS LONGINT, BYVAL V_ADDRESS AS LONGINT, BYVAL V_CALLEES AS LONGINT PTR, BYVAL N_CALLEES AS LONGINT, BYREF V_COUNT AS LONG, BYREF V_COMPLETE AS LONG)
9360     DIM S_PENDING(0 TO 256 - 1) AS LONGINT
9370     DIM V_PENDING AS LONGINT PTR = @S_PENDING(0)
9380     DIM S_VISITED(0 TO 1024 - 1) AS LONGINT
9390     DIM V_VISITED AS LONGINT PTR = @S_VISITED(0)
9400     DIM V_PC AS LONGINT
9410     DIM V_TARGET AS LONGINT
9420     DIM V_DECODED AS INSTRUCTION
9430     DIM V_PENDING_COUNT AS LONG
9440     DIM V_VISITED_COUNT AS LONG
9450     V_COUNT = 0
9460     V_COMPLETE = 0
9470     IF V_ADDRESS <= 0  ORELSE  V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - 4096 THEN
9480         EXIT SUB
9490     END IF
9500     V_PENDING[0] = V_ADDRESS
9510     V_PENDING_COUNT = 1
9520     V_VISITED_COUNT = 0
9530     WHILE (V_PENDING_COUNT > 0)
9540         V_PC = V_PENDING[V_PENDING_COUNT - 1]
9550         V_PENDING_COUNT = V_PENDING_COUNT - 1
9560         DO
9570             IF FL_CONTAINS(V_VISITED, V_VISITED_COUNT, V_PC) THEN
9580                 EXIT DO
9590             END IF
9600             IF V_VISITED_COUNT = 1024 THEN
9610                 EXIT SUB
9620             END IF
9630             IF V_PC < V_ADDRESS  ORELSE  V_PC - V_ADDRESS >= 4096 THEN
9640                 EXIT SUB
9650             END IF
9660             IF F_INSTRUCTION_AT(V_DECODER, V_REGIONS, N_REGIONS, V_PC, V_DECODED) = 0 THEN
9670                 EXIT SUB
9680             END IF
9690             IF V_DECODED.UNSAFE <> 0 THEN
9700                 EXIT SUB
9710             END IF
9720             V_VISITED_COUNT = V_VISITED_COUNT + 1
9730             V_VISITED[V_VISITED_COUNT - 1] = V_PC
9740             REM BRANCH ON V_DECODED.KIND
9750             IF (V_DECODED.KIND = 8) THEN
9760                 EXIT DO
9770             ELSEIF (V_DECODED.KIND = 6) ORELSE (V_DECODED.KIND = 7) THEN
9780                 V_TARGET = V_DECODED.TARGET
9790                 IF V_DECODED.RELATIVE = 1 THEN
9800                     V_TARGET = F_POINTER_AT(V_REGIONS, N_REGIONS, V_TARGET)
9810                 END IF
9820                 IF V_DECODED.KIND = 7  ANDALSO  V_TARGET >= V_ADDRESS  ANDALSO   V_TARGET - V_ADDRESS < 4096 THEN
9830                     V_PC = V_TARGET
9840                     CONTINUE DO
9850                 END IF
9860                 V_TARGET = F_RESOLVE(V_DECODER, V_REGIONS, N_REGIONS, V_TARGET)
9870                 IF V_TARGET > 0  ANDALSO   NOT  FL_CONTAINS(V_CALLEES, V_COUNT, V_TARGET) THEN
9880                     IF V_COUNT = N_CALLEES THEN
9890                         EXIT SUB
9900                     END IF
9910                     V_COUNT = V_COUNT + 1
9920                     V_CALLEES[V_COUNT - 1] = V_TARGET
9930                 END IF
9940                 IF V_DECODED.KIND = 7 THEN
9950                     EXIT DO
9960                 END IF
9970             ELSEIF (V_DECODED.KIND = 9) THEN
9980                 V_TARGET = V_DECODED.TARGET
9990                 IF V_TARGET < V_ADDRESS  ORELSE  V_TARGET - V_ADDRESS >= 4096 THEN
10000                     EXIT SUB
10010                 END IF
10020                 IF  NOT  FL_CONTAINS(V_VISITED, V_VISITED_COUNT, V_TARGET)  ANDALSO    NOT  FL_CONTAINS(V_PENDING, V_PENDING_COUNT, V_TARGET) THEN
10030                     IF V_PENDING_COUNT = 256 THEN
10040                         EXIT SUB
10050                     END IF
10060                     V_PENDING_COUNT = V_PENDING_COUNT + 1
10070                     V_PENDING[V_PENDING_COUNT - 1] = V_TARGET
10080                 END IF
10090             END IF
10100             V_PC = V_PC + V_DECODED.SIZE
10110         LOOP
10120     WEND
10130     V_COMPLETE = (-1)
10140 END SUB

10150 SUB FL_ANALYZE CDECL ALIAS "fl_analyze"(BYVAL V_ARCH AS LONG, BYVAL V_ABI AS LONG, BYVAL V_REGIONS AS REGION PTR, BYVAL V_COUNT AS LONG, BYVAL V_EXPORTED AS LONGINT, BYVAL V_LICENSE AS LONGINT, BYREF V_OUT AS RESULT)
10160     DIM FL_I AS LONGINT
10170     DIM V_DECODER AS ANY PTR
10180     DIM V_POINTER AS ANY PTR
10190     DIM V_DECODED AS INSTRUCTION
10200     DIM V_BYTES AS BYTE PTR
10210     DIM N_BYTES AS LONGINT
10220     DIM S_REGISTER_FILE(0 TO (31 - 0 + 1) - 1) AS LONGINT
10230     DIM V_REGISTER_FILE AS LONGINT PTR = @S_REGISTER_FILE(0)
10240     DIM S_CANDIDATES(0 TO V_CANDIDATE_LIMIT - 1) AS LONGINT
10250     DIM V_CANDIDATES AS LONGINT PTR = @S_CANDIDATES(0)
10260     DIM V_VALUE AS LONGINT
10270     DIM V_TARGET AS LONGINT
10280     DIM V_OFFSET AS LONGINT
10290     DIM V_PC AS LONGINT
10300     DIM V_LICENSE_TARGET AS LONGINT
10310     DIM V_K AS LONG
10320     DIM V_R AS LONG
10330     DIM V_ARGUMENT_REGISTER AS LONG
10340     DIM V_CANDIDATE_COUNT AS LONG
10350     DIM V_STEP AS LONG
10360     DIM V_OVERFLOW AS LONG
10370     DIM V_EVIDENCE AS STRING
10380     V_OUT = TYPE<RESULT>(0LL, 0, 0, 0, 0)
10390     IF V_COUNT <= 0  ORELSE  V_COUNT > 4096  ORELSE   (V_ARCH <> 1  ANDALSO  V_ARCH <> 2)  ORELSE   (V_ABI <> 0  ANDALSO  V_ABI <> 1) THEN
10400         V_OUT.REASON = 1
10410         EXIT SUB
10420     END IF
10430     FOR V_K = 1 TO V_COUNT
10440         IF V_REGIONS[V_K - 1].ADDRESS < 0  ORELSE  V_REGIONS[V_K - 1].SIZE < 0  ORELSE   V_REGIONS[V_K - 1].SIZE > 536870912LL THEN
10450             V_OUT.REASON = 1
10460             EXIT SUB
10470         END IF
10480         IF V_REGIONS[V_K - 1].ADDRESS > &H7FFFFFFFFFFFFFFFLL - V_REGIONS[V_K - 1].SIZE THEN
10490             V_OUT.REASON = 1
10500             EXIT SUB
10510         END IF
10520     NEXT
10530     V_DECODER = FL_DECODER_OPEN(V_ARCH)
10540     IF  NOT  (V_DECODER <> 0) THEN
10550         V_OUT.REASON = 2
10560         EXIT SUB
10570     END IF
10580     IF V_EXPORTED <> 0 THEN
10590         V_TARGET = F_RESOLVE(V_DECODER, (@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_EXPORTED)
10600         IF V_TARGET <> 0 THEN
10610             V_OUT = TYPE<RESULT>(V_TARGET, 1, 1, 0, 0)
10620         ELSE
10630             V_OUT.REASON = 3
10640         END IF
10650         FL_DECODER_CLOSE(V_DECODER)
10660         EXIT SUB
10670     END IF
10680     V_LICENSE_TARGET = F_RESOLVE(V_DECODER, (@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_LICENSE)
10690     V_ARGUMENT_REGISTER = 0
10700     IF V_ARCH = 1 THEN
10710         V_ARGUMENT_REGISTER = IIF(V_ABI = 1, 1, (7))
10720     END IF
10730     V_CANDIDATE_COUNT = 0
10740     V_OVERFLOW = 0
10750     FOR V_K = 1 TO V_COUNT
10760         IF V_REGIONS[V_K - 1].EXECUTABLE = 0  ORELSE   V_REGIONS[V_K - 1].SIZE = 0 THEN
10770             CONTINUE FOR
10780         END IF
10790         IF  NOT  (V_REGIONS[V_K - 1].BYTES <> 0) THEN
10800             CONTINUE FOR
10810         END IF
10820         V_BYTES = CAST(BYTE PTR, V_REGIONS[V_K - 1].BYTES)
10830         N_BYTES = V_REGIONS[V_K - 1].SIZE
10840         FOR FL_I = 0 TO ((31 - 0 + 1) + 0 - 1)
10850             V_REGISTER_FILE[FL_I] = 0
10860         NEXT
10870         V_OFFSET = 0
10880         V_STEP = IIF(V_ARCH = 2, 4, (1))
10890         WHILE (V_OFFSET < V_REGIONS[V_K - 1].SIZE)
10900             V_PC = V_REGIONS[V_K - 1].ADDRESS + V_OFFSET
10910             V_POINTER = @(V_BYTES[V_OFFSET + 1 - 1])
10920             IF FL_DECODE(V_DECODER, V_POINTER, CLNGINT(V_REGIONS[V_K - 1].SIZE - V_OFFSET), V_PC, V_DECODED) = 0 THEN
10930                 V_OFFSET = V_OFFSET + V_STEP
10940                 FOR FL_I = 0 TO ((31 - 0 + 1) + 0 - 1)
10950                     V_REGISTER_FILE[FL_I] = 0
10960                 NEXT
10970                 CONTINUE WHILE
10980             END IF
10990             V_VALUE = 0
11000             REM BRANCH ON V_DECODED.KIND
11010             IF (V_DECODED.KIND = 1) ORELSE (V_DECODED.KIND = 2) THEN
11020                 V_VALUE = V_DECODED.TARGET
11030             ELSEIF (V_DECODED.KIND = 5) THEN
11040                 IF V_DECODED.SRC >= 0 THEN
11050                     V_VALUE = V_REGISTER_FILE[V_DECODED.SRC]
11060                 END IF
11070             ELSEIF (V_DECODED.KIND = 3) THEN
11080                 IF V_DECODED.SRC >= 0 THEN
11090                     IF V_REGISTER_FILE[V_DECODED.SRC] > 0  ANDALSO   V_DECODED.IMMEDIATE >= 0 THEN
11100                         V_VALUE = F_ADDRESS_SUM(V_REGISTER_FILE[V_DECODED.SRC], V_DECODED.IMMEDIATE)
11110                     END IF
11120                 END IF
11130             ELSEIF (V_DECODED.KIND = 4) THEN
11140                 V_TARGET = V_DECODED.TARGET
11150                 IF V_DECODED.BASE >= 0  ANDALSO  V_DECODED.INDEX < 0 THEN
11160                     IF V_REGISTER_FILE[V_DECODED.BASE] > 0 THEN
11170                         V_TARGET = F_ADDRESS_SUM(V_REGISTER_FILE[V_DECODED.BASE], V_DECODED.IMMEDIATE)
11180                     END IF
11190                 END IF
11200                 V_VALUE = F_POINTER_AT((@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_TARGET)
11210             ELSEIF (V_DECODED.KIND = 6) THEN
11220                 IF F_IS_TARGET((@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_REGISTER_FILE[V_ARGUMENT_REGISTER]) THEN
11230                     V_OUT.REFERENCES = V_OUT.REFERENCES + 1
11240                     V_TARGET = V_DECODED.TARGET
11250                     IF V_DECODED.RELATIVE = 1 THEN
11260                         V_TARGET = F_POINTER_AT((@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_TARGET)
11270                     END IF
11280                     IF V_DECODED.SRC >= 0 THEN
11290                         V_TARGET = V_REGISTER_FILE[V_DECODED.SRC]
11300                     END IF
11310                     V_TARGET = F_RESOLVE(V_DECODER, (@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_TARGET)
11320                     V_EVIDENCE = "LUMINA argument witness at 0x" & HEX(V_PC,16) & " calls 0x" & HEX(V_TARGET,16)
11330                     FL_LOG(TRIM(V_EVIDENCE) & CHR(0))
11340                     IF V_TARGET <> 0  ANDALSO   F_CALLS_LICENSE(V_DECODER, (@V_REGIONS[0]), ((V_COUNT) - (1) + 1), V_TARGET, V_LICENSE_TARGET) THEN
11350                         IF  NOT  FL_CONTAINS(V_CANDIDATES, V_CANDIDATE_COUNT, V_TARGET) THEN
11360                             IF V_CANDIDATE_COUNT = V_CANDIDATE_LIMIT THEN
11370                                 V_OVERFLOW = (-1)
11380                             ELSE
11390                                 V_CANDIDATE_COUNT = V_CANDIDATE_COUNT + 1
11400                                 V_CANDIDATES[V_CANDIDATE_COUNT - 1] = V_TARGET
11410                             END IF
11420                         END IF
11430                     END IF
11440                 END IF
11450             END IF
11460             FOR V_R = 0 TO 31
11470                 IF ((V_DECODED.WRITES AND (1ULL SHL V_R)) <> 0) THEN
11480                     V_REGISTER_FILE[V_R] = 0
11490                 END IF
11500             NEXT
11510             IF V_DECODED.DST >= 0  ANDALSO  V_DECODED.DST <= 31 THEN
11520                 REM BRANCH ON V_DECODED.KIND
11530                 IF (V_DECODED.KIND = 1) ORELSE (V_DECODED.KIND = 2) ORELSE (V_DECODED.KIND = 5) ORELSE (V_DECODED.KIND = 3) ORELSE (V_DECODED.KIND = 4) THEN
11540                     V_REGISTER_FILE[V_DECODED.DST] = V_VALUE
11550                 END IF
11560             END IF
11570             IF V_DECODED.KIND >= 6 THEN
11580                 FOR FL_I = 0 TO ((31 - 0 + 1) + 0 - 1)
11590                     V_REGISTER_FILE[FL_I] = 0
11600                 NEXT
11610             END IF
11620             V_OFFSET = V_OFFSET + V_DECODED.SIZE
11630         WEND
11640     NEXT
11650     V_OUT.CANDIDATES = V_CANDIDATE_COUNT
11660     IF V_CANDIDATE_COUNT = 1  ANDALSO   NOT  V_OVERFLOW THEN
11670         V_OUT.TARGET = V_CANDIDATES[0]
11680         V_OUT.STATUS = 2
11690     ELSE
11700         V_OUT.REASON = 4
11710         IF V_LICENSE_TARGET = 0 THEN
11720             V_OUT.REASON = 5
11730         END IF
11740         IF V_CANDIDATE_COUNT > 1  ORELSE  V_OVERFLOW THEN
11750             V_OUT.REASON = 6
11760         END IF
11770     END IF
11780     FL_DECODER_CLOSE(V_DECODER)
11790 END SUB
