14400 FUNCTION FL_READ CDECL ALIAS "fl_read"(BYVAL V_ADDRESS AS LONGINT, BYVAL V_OUTPUT AS ANY PTR, BYVAL V_LENGTH AS ULONGINT) AS LONG
14410     DIM V_TRANSFERRED AS LONGINT
14420     DIM V_STATUS AS LONG
14430     DIM V_LOCAL AS IO_VECTOR
14440     DIM V_REMOTE AS IO_VECTOR
14450     DIM V_SUCCESS AS LONG
14460     V_SUCCESS = 0
14470     IF V_ADDRESS <= 0  ORELSE  V_LENGTH <= 0  ORELSE   NOT  (V_OUTPUT <> 0) THEN
14480         RETURN V_SUCCESS
14490     END IF
14500     IF V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - V_LENGTH THEN
14510         RETURN V_SUCCESS
14520     END IF
#IFDEF FL_OS_WINDOWS
14530     V_STATUS = READPROCESSMEMORY(GETCURRENTPROCESS(), V_ADDRESS, V_OUTPUT, V_LENGTH, V_TRANSFERRED)
14540     IF V_STATUS <> 0  ANDALSO  V_TRANSFERRED = V_LENGTH THEN
14550         V_SUCCESS = 1
14560     END IF
#ELSEIF DEFINED(FL_OS_MACOS)
14570     V_STATUS = MACH_VM_READ_OVERWRITE(FL_TASK_SELF(), V_ADDRESS, V_LENGTH, V_OUTPUT, V_TRANSFERRED)
14580     IF V_STATUS = 0  ANDALSO  V_TRANSFERRED = V_LENGTH THEN
14590         V_SUCCESS = 1
14600     END IF
#ELSE
14610     V_LOCAL = TYPE<IO_VECTOR>(V_OUTPUT, V_LENGTH)
14620     V_REMOTE = TYPE<IO_VECTOR>(CAST(ANY PTR, V_ADDRESS), V_LENGTH)
14630     V_TRANSFERRED = PROCESS_VM_READV(GETPID(), V_LOCAL, 1LL, V_REMOTE, 1LL, 0LL)
14640     IF V_TRANSFERRED = V_LENGTH THEN
14650         V_SUCCESS = 1
14660     END IF
#ENDIF
14670     RETURN V_SUCCESS
14680 END FUNCTION

14690 FUNCTION F_QUERY_MAPPING CDECL(BYVAL V_ADDRESS AS LONGINT, BYREF V_MAPPING AS MEMORY_MAPPING) AS LONG
#IFDEF FL_OS_WINDOWS
14700     DIM V_INFO AS WINDOWS_MAPPING
#ELSE
14710     DIM S_INFO(0 TO 16 - 1) AS LONG
14720     DIM V_INFO AS LONG PTR = @S_INFO(0)
#ENDIF
14730     DIM V_TRANSFERRED AS ULONGINT
14740     DIM V_FIRST AS LONGINT
14750     DIM V_LENGTH AS LONGINT
14760     DIM V_COUNT AS LONG
14770     DIM V_OBJECT AS LONG
14780     DIM V_STATUS AS LONG
14790     DIM V_IGNORED AS LONG
14800     DIM V_LIMIT AS LONGINT
14810     DIM V_FOUND AS LONG
14820     V_FOUND = 0
14830     V_MAPPING = TYPE<MEMORY_MAPPING>(0, 0, 0)
14840     IF V_ADDRESS <= 0 THEN
14850         RETURN V_FOUND
14860     END IF
#IFDEF FL_OS_WINDOWS
14870     V_TRANSFERRED = VIRTUALQUERY(V_ADDRESS, V_INFO, SIZEOF(V_INFO))
14880     IF V_TRANSFERRED <> SIZEOF(V_INFO)  ORELSE  V_INFO.STATE <> CLNGINT(&H1000ULL) THEN
14890         RETURN V_FOUND
14900     END IF
14910     IF (V_INFO.PROTECTION AND (CLNGINT(&H101ULL))) <> 0 THEN
14920         RETURN V_FOUND
14930     END IF
14940     IF V_INFO.BASE > &H7FFFFFFFFFFFFFFFLL - V_INFO.SIZE THEN
14950         RETURN V_FOUND
14960     END IF
14970     V_MAPPING = TYPE<MEMORY_MAPPING>(V_INFO.BASE, V_INFO.BASE + V_INFO.SIZE, V_INFO.PROTECTION)
#ELSEIF DEFINED(FL_OS_MACOS)
14980     V_FIRST = V_ADDRESS
14990     V_COUNT = 16
15000     V_OBJECT = 0
15010     V_STATUS = MACH_VM_REGION(FL_TASK_SELF(), V_FIRST, V_LENGTH, 9LL, V_INFO, V_COUNT, V_OBJECT)
15020     IF V_OBJECT <> 0 THEN
15030         V_IGNORED = MACH_PORT_DEALLOCATE(FL_TASK_SELF(), V_OBJECT)
15040     END IF
15050     IF V_STATUS <> 0  ORELSE  V_FIRST > V_ADDRESS  ORELSE  V_LENGTH <= 0 THEN
15060         RETURN V_FOUND
15070     END IF
15080     IF V_FIRST > &H7FFFFFFFFFFFFFFFLL - V_LENGTH THEN
15090         RETURN V_FOUND
15100     END IF
15110     V_MAPPING = TYPE<MEMORY_MAPPING>(V_FIRST, V_FIRST + V_LENGTH, V_INFO[0])
#ELSE
15120     DIM MAPS AS ANY PTR = FOPEN("/proc/self/maps", "r")
15130     DIM BUFFER AS ZSTRING * 4096
15140     DIM PERMS AS ZSTRING * 5
15150     IF MAPS = 0 THEN RETURN V_FOUND
15160     WHILE FGETS(@BUFFER, SIZEOF(BUFFER), MAPS) <> 0
15170         IF SSCANF(@BUFFER, "%llx-%llx %4s", @V_FIRST, @V_LIMIT, @PERMS) <> 3 THEN CONTINUE WHILE
15180         IF V_ADDRESS < V_FIRST ORELSE V_ADDRESS >= V_LIMIT THEN CONTINUE WHILE
15190         V_MAPPING = TYPE<MEMORY_MAPPING>(V_FIRST, V_LIMIT, 0)
15200         IF PERMS[0] = ASC("r") THEN V_MAPPING.PROTECTION OR= 1
15210         IF PERMS[1] = ASC("w") THEN V_MAPPING.PROTECTION OR= 2
15220         IF PERMS[2] = ASC("x") THEN V_MAPPING.PROTECTION OR= 4
15230         V_FOUND = -1
15240         EXIT WHILE
15250     WEND
15260     FCLOSE(MAPS)
15270     RETURN V_FOUND
#ENDIF
15280     V_FOUND = (-1)
15290     RETURN V_FOUND
15300 END FUNCTION

15310 FUNCTION F_READABLE CDECL(BYVAL V_PROTECTION AS LONG) AS LONG
15320     DIM V_ALLOWED AS LONG
#IFDEF FL_OS_WINDOWS
15330     REM BRANCH ON (V_PROTECTION AND (255))
15340     IF ((V_PROTECTION AND (255)) = 2) ORELSE ((V_PROTECTION AND (255)) = 4) ORELSE ((V_PROTECTION AND (255)) = 8) ORELSE ((V_PROTECTION AND (255)) = 32) ORELSE ((V_PROTECTION AND (255)) = 64) ORELSE ((V_PROTECTION AND (255)) = 128) THEN
15350         V_ALLOWED = (-1)
15360     ELSE
15370         V_ALLOWED = 0
15380     END IF
#ELSE
15390     V_ALLOWED = ((V_PROTECTION AND (1ULL SHL 0)) <> 0)
#ENDIF
15400     RETURN V_ALLOWED
15410 END FUNCTION

15420 FUNCTION F_EXECUTABLE CDECL(BYVAL V_PROTECTION AS LONG) AS LONG
15430     DIM V_ALLOWED AS LONG
#IFDEF FL_OS_WINDOWS
15440     V_ALLOWED = (V_PROTECTION AND (240)) <> 0
#ELSE
15450     V_ALLOWED = ((V_PROTECTION AND (1ULL SHL 2)) <> 0)
#ENDIF
15460     RETURN V_ALLOWED
15470 END FUNCTION

15480 SUB F_CAPTURE_RANGE CDECL(BYREF V_BUILDER AS SNAPSHOT_BUILDER, BYVAL V_ADDRESS AS LONGINT, BYVAL V_LENGTH AS LONGINT, BYVAL V_IS_EXECUTABLE AS LONG)
15490     DIM V_MAPPING AS MEMORY_MAPPING
15500     DIM V_REGIONS AS REGION PTR
15510     DIM N_REGIONS AS LONGINT
15520     DIM V_COPY AS BYTE PTR
15530     DIM V_CURSOR AS LONGINT
15540     DIM V_LIMIT AS LONGINT
15550     DIM V_CHUNK_SIZE AS LONGINT
15560     DIM V_STATUS AS LONG
15570     IF V_BUILDER.FAILED <> 0 THEN
15580         EXIT SUB
15590     END IF
15600     V_BUILDER.FAILED = 1
15610     IF V_ADDRESS <= 0  ORELSE  V_LENGTH <= 0  ORELSE  V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - V_LENGTH THEN
15620         EXIT SUB
15630     END IF
15640     V_REGIONS = CAST(REGION PTR, V_BUILDER.STORAGE)
15650     N_REGIONS = V_REGION_LIMIT
15660     V_CURSOR = V_ADDRESS
15670     V_LIMIT = V_ADDRESS + V_LENGTH
15680     WHILE (V_CURSOR < V_LIMIT)
15690         IF  NOT  F_QUERY_MAPPING(V_CURSOR, V_MAPPING) THEN
15700             EXIT SUB
15710         END IF
15720         IF  NOT  F_READABLE(V_MAPPING.PROTECTION) THEN
15730             EXIT SUB
15740         END IF
15750         IF V_IS_EXECUTABLE  ANDALSO   NOT  F_EXECUTABLE(V_MAPPING.PROTECTION) THEN
15760             EXIT SUB
15770         END IF
15780         V_CHUNK_SIZE = FL_MIN(V_MAPPING.LIMIT, V_LIMIT) - V_CURSOR
15790         IF V_CHUNK_SIZE <= 0  ORELSE  V_BUILDER.COUNT = V_REGION_LIMIT THEN
15800             EXIT SUB
15810         END IF
15820         IF V_CHUNK_SIZE > V_SNAPSHOT_LIMIT - V_BUILDER.TOTAL THEN
15830             EXIT SUB
15840         END IF
15850         V_COPY = CALLOCATE(V_CHUNK_SIZE * SIZEOF(BYTE))
15860         V_STATUS = IIF(V_COPY = 0, 1, 0)
15870         IF V_STATUS <> 0 THEN
15880             EXIT SUB
15890         END IF
15900         IF FL_READ(V_CURSOR, V_COPY, V_CHUNK_SIZE) = 0 THEN
15910             DEALLOCATE(V_COPY)
15920             EXIT SUB
15930         END IF
15940         V_BUILDER.COUNT = V_BUILDER.COUNT + 1
15950         V_REGIONS[V_BUILDER.COUNT - 1] = TYPE<REGION>(V_CURSOR, V_CHUNK_SIZE, V_COPY, IIF(V_IS_EXECUTABLE, 1, (0)), 0)
15960         V_COPY = 0
15970         V_BUILDER.TOTAL = V_BUILDER.TOTAL + V_CHUNK_SIZE
15980         V_CURSOR = V_CURSOR + V_CHUNK_SIZE
15990     WEND
16000     V_BUILDER.FAILED = 0
16010 END SUB

16020 FUNCTION FL_SNAPSHOT CDECL ALIAS "fl_snapshot"(BYREF V_MEMORY AS ANY PTR, BYREF V_COUNT AS LONG) AS LONG
16030     DIM V_BUILDER AS SNAPSHOT_BUILDER
16040     DIM V_REGIONS AS REGION PTR
16050     DIM N_REGIONS AS LONGINT
16060     DIM V_ALLOCATION_STATUS AS LONG
16070     DIM V_IGNORED AS LONG
16080     DIM V_SUCCESS AS LONG
16090     V_SUCCESS = 0
16100     V_MEMORY = 0
16110     V_COUNT = 0
16120     V_BUILDER = TYPE<SNAPSHOT_BUILDER>(0, 0LL, 0LL, 0, 0)
16130     V_BUILDER.ANCHOR = CLNGINT(FL_SYMBOL("has_valid_add_on" & CHR(0)))
16140     IF V_BUILDER.ANCHOR = 0 THEN
16150         V_BUILDER.ANCHOR = CLNGINT(FL_SYMBOL("is_license_valid" & CHR(0)))
16160     END IF
16170     IF V_BUILDER.ANCHOR = 0 THEN
16180         V_BUILDER.ANCHOR = CLNGINT(FL_SYMBOL("get_license_manager" & CHR(0)))
16190     END IF
16200     IF V_BUILDER.ANCHOR = 0 THEN
16210         V_BUILDER.ANCHOR = CLNGINT(FL_SYMBOL("msg" & CHR(0)))
16220     END IF
16230     IF V_BUILDER.ANCHOR <= 0 THEN
16240         RETURN V_SUCCESS
16250     END IF
16260     V_REGIONS = CALLOCATE(V_REGION_LIMIT * SIZEOF(REGION))
16270     V_ALLOCATION_STATUS = IIF(V_REGIONS = 0, 1, 0)
16280     IF V_ALLOCATION_STATUS <> 0 THEN
16290         RETURN V_SUCCESS
16300     END IF
16310     V_BUILDER.STORAGE = V_REGIONS
#IFDEF FL_OS_WINDOWS
16320     F_CAPTURE_PE_IMAGE(V_BUILDER)
#ELSEIF DEFINED(FL_OS_MACOS)
16330     F_CAPTURE_MACHO_IMAGE(V_BUILDER)
#ELSE
16340     V_IGNORED = DL_ITERATE_PHDR(@F_CAPTURE_ELF_IMAGE, @(V_BUILDER))
#ENDIF
16350     IF V_BUILDER.FAILED <> 0  ORELSE  V_BUILDER.COUNT = 0 THEN
16360         FL_SNAPSHOT_FREE(V_BUILDER.STORAGE, V_BUILDER.COUNT)
16370         RETURN V_SUCCESS
16380     END IF
16390     V_MEMORY = V_BUILDER.STORAGE
16400     V_COUNT = V_BUILDER.COUNT
16410     V_SUCCESS = 1
16420     RETURN V_SUCCESS
16430 END FUNCTION

16440 SUB FL_SNAPSHOT_FREE CDECL ALIAS "fl_snapshot_free"(BYVAL V_MEMORY AS ANY PTR, BYVAL V_COUNT AS LONG)
16450     DIM V_REGIONS AS REGION PTR
16460     DIM N_REGIONS AS LONGINT
16470     DIM V_BYTES AS BYTE PTR
16480     DIM N_BYTES AS LONGINT
16490     DIM V_INDEX AS LONG
16500     IF  NOT  (V_MEMORY <> 0) THEN
16510         EXIT SUB
16520     END IF
16530     V_REGIONS = CAST(REGION PTR, V_MEMORY)
16540     N_REGIONS = V_REGION_LIMIT
16550     FOR V_INDEX = 1 TO V_COUNT
16560         V_BYTES = CAST(BYTE PTR, V_REGIONS[V_INDEX - 1].BYTES)
16570         N_BYTES = V_REGIONS[V_INDEX - 1].SIZE
16580         DEALLOCATE(V_BYTES)
16590     NEXT
16600     DEALLOCATE(V_REGIONS)
16610 END SUB

#IFDEF FL_OS_WINDOWS
16620 SUB F_CAPTURE_PE_IMAGE CDECL(BYREF V_BUILDER AS SNAPSHOT_BUILDER)
16630     DIM V_MODULE AS ANY PTR
16640     DIM S_DOS(0 TO 64 - 1) AS BYTE
16650     DIM V_DOS AS BYTE PTR = @S_DOS(0)
16660     DIM S_NT(0 TO 88 - 1) AS BYTE
16670     DIM V_NT AS BYTE PTR = @S_NT(0)
16680     DIM S_SECTION(0 TO 40 - 1) AS BYTE
16690     DIM V_SECTION AS BYTE PTR = @S_SECTION(0)
16700     DIM V_BASE AS LONGINT
16710     DIM V_PE_OFFSET AS LONGINT
16720     DIM V_IMAGE_SIZE AS LONGINT
16730     DIM V_SECTION_ADDRESS AS LONGINT
16740     DIM V_SECTION_SIZE AS LONGINT
16750     DIM V_FLAGS AS LONGINT
16760     DIM V_SECTIONS AS LONG
16770     DIM V_OPTIONAL_SIZE AS LONG
16780     DIM V_INDEX AS LONG
16790     V_BUILDER.FAILED = 1
16800     IF GETMODULEHANDLEEXA(6LL, V_BUILDER.ANCHOR, V_MODULE) = 0 THEN
16810         EXIT SUB
16820     END IF
16830     V_BASE = CLNGINT(V_MODULE)
16840     IF FL_READ(V_BASE, V_DOS, 64LL) = 0 THEN
16850         EXIT SUB
16860     END IF
16870     IF F_LOAD_LE(V_DOS, 64, 2) <> CLNGINT(&H5A4DULL) THEN
16880         EXIT SUB
16890     END IF
16900     V_PE_OFFSET = F_LOAD_LE((@V_DOS[61 - 1]), ((64 + 1 - 1) - (61) + 1), 4)
16910     IF V_PE_OFFSET > 1048576 THEN
16920         EXIT SUB
16930     END IF
16940     IF FL_READ(V_BASE + V_PE_OFFSET, V_NT, 88LL) = 0 THEN
16950         EXIT SUB
16960     END IF
16970     IF F_LOAD_LE(V_NT, 88, 4) <> CLNGINT(&H4550ULL)  ORELSE  F_LOAD_LE((@V_NT[25 - 1]), ((88 + 1 - 1) - (25) + 1), 2) <> 523 THEN
16980         EXIT SUB
16990     END IF
17000     V_SECTIONS = CLNGINT(F_LOAD_LE((@V_NT[7 - 1]), ((88 + 1 - 1) - (7) + 1), 2))
17010     V_OPTIONAL_SIZE = CLNGINT(F_LOAD_LE((@V_NT[21 - 1]), ((88 + 1 - 1) - (21) + 1), 2))
17020     V_IMAGE_SIZE = F_LOAD_LE((@V_NT[81 - 1]), ((88 + 1 - 1) - (81) + 1), 4)
17030     IF V_SECTIONS > 96  ORELSE  V_OPTIONAL_SIZE < 64 THEN
17040         EXIT SUB
17050     END IF
17060     V_BUILDER.FAILED = 0
17070     FOR V_INDEX = 0 TO V_SECTIONS - 1
17080         V_SECTION_ADDRESS = V_BASE + V_PE_OFFSET + 24 + V_OPTIONAL_SIZE + 40*V_INDEX
17090         IF FL_READ(V_SECTION_ADDRESS, V_SECTION, 40LL) = 0 THEN
17100             EXIT FOR
17110         END IF
17120         V_SECTION_ADDRESS = F_LOAD_LE((@V_SECTION[13 - 1]), ((40 + 1 - 1) - (13) + 1), 4)
17130         V_SECTION_SIZE = F_LOAD_LE((@V_SECTION[9 - 1]), ((40 + 1 - 1) - (9) + 1), 4)
17140         V_FLAGS = F_LOAD_LE((@V_SECTION[37 - 1]), ((40 + 1 - 1) - (37) + 1), 4)
17150         IF V_SECTION_ADDRESS > V_IMAGE_SIZE  ORELSE  V_SECTION_SIZE > V_IMAGE_SIZE - V_SECTION_ADDRESS THEN
17160             EXIT FOR
17170         END IF
17180         IF ((V_FLAGS AND (1ULL SHL 30)) <> 0)  ANDALSO  V_SECTION_SIZE > 0 THEN
17190             F_CAPTURE_RANGE(V_BUILDER, V_BASE + V_SECTION_ADDRESS, V_SECTION_SIZE, ((V_FLAGS AND (1ULL SHL 29)) <> 0))
17200             IF V_BUILDER.FAILED <> 0 THEN
17210                 EXIT SUB
17220             END IF
17230         END IF
17240     NEXT
17250     IF V_INDEX <> V_SECTIONS THEN
17260         V_BUILDER.FAILED = 1
17270     END IF
17280 END SUB
#ENDIF

#IFDEF FL_OS_MACOS
17290 SUB F_CAPTURE_MACHO_IMAGE CDECL(BYREF V_BUILDER AS SNAPSHOT_BUILDER)
17300     DIM V_INFO AS DYNAMIC_SYMBOL_INFO
17310     DIM S_HEADER(0 TO 32 - 1) AS BYTE
17320     DIM V_HEADER AS BYTE PTR = @S_HEADER(0)
17330     DIM V_COMMANDS AS BYTE PTR
17340     DIM V_BASE AS LONGINT
17350     DIM V_COMMAND_SIZE AS LONGINT
17360     DIM V_OFFSET AS LONGINT
17370     DIM V_SIZE AS LONGINT
17380     DIM V_SLIDE AS LONGINT
17390     DIM V_ADDRESS AS LONGINT
17400     DIM V_LENGTH AS LONGINT
17410     DIM V_FLAGS AS LONGINT
17420     DIM V_COMMAND_COUNT AS LONG
17430     DIM V_INDEX AS LONG
17440     DIM V_PASS AS LONG
17450     DIM V_ALLOCATION_STATUS AS LONG
17460     DIM V_FOUND AS LONG
17470     V_BUILDER.FAILED = 1
17480     IF DLADDR(V_BUILDER.ANCHOR, V_INFO) = 0 THEN
17490         EXIT SUB
17500     END IF
17510     V_BASE = CLNGINT(V_INFO.MODULE_BASE)
17520     IF FL_READ(V_BASE, V_HEADER, 32LL) = 0 THEN
17530         EXIT SUB
17540     END IF
17550     IF F_LOAD_LE(V_HEADER, 32, 4) <> CLNGINT(&HFEEDFACFULL) THEN
17560         EXIT SUB
17570     END IF
17580     V_COMMAND_COUNT = CLNGINT(F_LOAD_LE((@V_HEADER[17 - 1]), ((32 + 1 - 1) - (17) + 1), 4))
17590     V_COMMAND_SIZE = F_LOAD_LE((@V_HEADER[21 - 1]), ((32 + 1 - 1) - (21) + 1), 4)
17600     IF V_COMMAND_SIZE < 8  ORELSE  V_COMMAND_SIZE > 16777216  ORELSE  V_COMMAND_COUNT > V_COMMAND_SIZE\8 THEN
17610         EXIT SUB
17620     END IF
17630     V_COMMANDS = CALLOCATE(V_COMMAND_SIZE * SIZEOF(BYTE))
17640     V_ALLOCATION_STATUS = IIF(V_COMMANDS = 0, 1, 0)
17650     IF V_ALLOCATION_STATUS <> 0 THEN
17660         EXIT SUB
17670     END IF
17680     IF FL_READ(V_BASE + 32, V_COMMANDS, V_COMMAND_SIZE) = 0 THEN
17690         GOTO 18110
17700     END IF
17710     V_SLIDE = 0
17720     V_FOUND = 0
17730     FOR V_PASS = 0 TO 1
17740         V_OFFSET = 0
17750         FOR V_INDEX = 1 TO V_COMMAND_COUNT
17760             IF V_OFFSET > V_COMMAND_SIZE - 8 THEN
17770                 GOTO 18110
17780             END IF
17790             V_SIZE = F_LOAD_LE((@V_COMMANDS[V_OFFSET + 5 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 5) + 1), 4)
17800             IF V_SIZE < 8  ORELSE  V_SIZE > V_COMMAND_SIZE - V_OFFSET THEN
17810                 GOTO 18110
17820             END IF
17830             IF F_LOAD_LE((@V_COMMANDS[V_OFFSET + 1 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 1) + 1), 4) = 25  ANDALSO  V_SIZE >= 72 THEN
17840                 IF V_PASS = 0  ANDALSO  F_LOAD_LE((@V_COMMANDS[V_OFFSET + 9 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 9) + 1), 8) = CLNGINT(&H0000545845545F5FULL) THEN
17850                     V_SLIDE = V_BASE - F_LOAD_LE((@V_COMMANDS[V_OFFSET + 25 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 25) + 1), 8)
17860                     V_FOUND = (-1)
17870                 END IF
17880                 IF V_PASS = 1 THEN
17890                     IF  NOT  V_FOUND THEN
17900                         GOTO 18110
17910                     END IF
17920                     V_ADDRESS = F_LOAD_LE((@V_COMMANDS[V_OFFSET + 25 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 25) + 1), 8) + V_SLIDE
17930                     V_LENGTH = F_LOAD_LE((@V_COMMANDS[V_OFFSET + 49 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 49) + 1), 8)
17940                     V_FLAGS = F_LOAD_LE((@V_COMMANDS[V_OFFSET + 61 - 1]), ((V_COMMAND_SIZE + 1 - 1) - (V_OFFSET + 61) + 1), 4)
17950                     IF ((V_FLAGS AND (1ULL SHL 0)) <> 0)  ANDALSO  V_LENGTH > 0 THEN
17960                         V_BUILDER.FAILED = 0
17970                         F_CAPTURE_RANGE(V_BUILDER, V_ADDRESS, V_LENGTH, ((V_FLAGS AND (1ULL SHL 2)) <> 0))
17980                         IF V_BUILDER.FAILED <> 0 THEN
17990                             GOTO 18110
18000                         END IF
18010                         V_BUILDER.FAILED = 1
18020                     END IF
18030                 END IF
18040             END IF
18050             V_OFFSET = V_OFFSET + V_SIZE
18060         NEXT
18070     NEXT
18080     IF V_FOUND THEN
18090         V_BUILDER.FAILED = 0
18100     END IF
18110     REM RELEASE MACHO COMMAND BUFFER
18120     IF V_COMMANDS <> 0 THEN DEALLOCATE(V_COMMANDS)
18130 END SUB
#ENDIF

#IFDEF FL_OS_LINUX
18140 FUNCTION F_CAPTURE_ELF_IMAGE CDECL(BYVAL V_MEMORY AS ANY PTR, BYVAL V_LENGTH AS ULONGINT, BYVAL V_CONTEXT AS ANY PTR) AS LONG
18150     DIM V_INFO AS ELF_LOADER_INFO PTR
18160     DIM V_HEADERS AS ELF_PROGRAM_HEADER PTR
18170     DIM N_HEADERS AS LONGINT
18180     DIM V_BUILDER AS SNAPSHOT_BUILDER PTR
18190     DIM V_ADDRESS AS LONGINT
18200     DIM V_INDEX AS LONG
18210     DIM V_COUNT AS LONG
18220     DIM V_FOUND AS LONG
18230     DIM V_STOP AS LONG
18240     V_STOP = 0
18250     IF V_LENGTH < 26 THEN
18260         RETURN V_STOP
18270     END IF
18280     V_INFO = CAST(ELF_LOADER_INFO PTR, V_MEMORY)
18290     V_BUILDER = CAST(SNAPSHOT_BUILDER PTR, V_CONTEXT)
18300     V_COUNT = (CLNGINT(V_INFO->HEADER_COUNT) AND (65535))
18310     V_HEADERS = CAST(ELF_PROGRAM_HEADER PTR, V_INFO->HEADERS)
18320     N_HEADERS = V_COUNT
18330     V_FOUND = 0
18340     FOR V_INDEX = 1 TO V_COUNT
18350         IF V_HEADERS[V_INDEX - 1].KIND <> 1 THEN
18360             CONTINUE FOR
18370         END IF
18380         V_ADDRESS = V_INFO->LOAD_BIAS + V_HEADERS[V_INDEX - 1].ADDRESS
18390         IF V_BUILDER->ANCHOR >= V_ADDRESS  ANDALSO  V_BUILDER->ANCHOR - V_ADDRESS < V_HEADERS[V_INDEX - 1].MEMORY_SIZE THEN
18400             V_FOUND = (-1)
18410         END IF
18420     NEXT
18430     IF  NOT  V_FOUND THEN
18440         RETURN V_STOP
18450     END IF
18460     V_STOP = 1
18470     FOR V_INDEX = 1 TO V_COUNT
18480         IF V_HEADERS[V_INDEX - 1].KIND <> 1  ORELSE   NOT  ((V_HEADERS[V_INDEX - 1].FLAGS AND (1ULL SHL 2)) <> 0) THEN
18490             CONTINUE FOR
18500         END IF
18510         IF V_HEADERS[V_INDEX - 1].FILE_SIZE = 0 THEN
18520             CONTINUE FOR
18530         END IF
18540         F_CAPTURE_RANGE(*V_BUILDER, V_INFO->LOAD_BIAS + V_HEADERS[V_INDEX - 1].ADDRESS, V_HEADERS[V_INDEX - 1].FILE_SIZE, ((V_HEADERS[V_INDEX - 1].FLAGS AND (1ULL SHL 0)) <> 0))
18550         IF V_BUILDER->FAILED <> 0 THEN
18560             RETURN V_STOP
18570         END IF
18580     NEXT
18590     RETURN V_STOP
18600 END FUNCTION
#ENDIF

18610 FUNCTION F_PAGE_SIZE CDECL() AS LONG
18620     DIM V_INFO AS WINDOWS_SYSTEM_INFO
18630     DIM V_LENGTH AS LONG
#IFDEF FL_OS_WINDOWS
18640     GETSYSTEMINFO(V_INFO)
18650     V_LENGTH = CLNGINT(V_INFO.PAGE_SIZE)
#ELSE
18660     V_LENGTH = CLNGINT(GETPAGESIZE())
#ENDIF
18670     RETURN V_LENGTH
18680 END FUNCTION

18690 FUNCTION FL_ALLOCATE_NEAR CDECL ALIAS "fl_allocate_near"(BYVAL V_TARGET AS LONGINT, BYVAL V_LENGTH AS ULONGINT) AS ANY PTR
18700     DIM V_MEMORY AS ANY PTR
18710     DIM V_REACH AS LONGINT
18720     DIM V_STEP AS LONGINT
18730     DIM V_ALIGNED AS LONGINT
18740     DIM V_DELTA AS LONGINT
18750     DIM V_HINT AS LONGINT
18760     DIM V_ALLOCATED AS LONGINT
18770     DIM V_DIRECTION AS LONG
18780     DIM V_INFO AS WINDOWS_SYSTEM_INFO
18790     V_MEMORY = 0
18800     IF V_TARGET <= 0  ORELSE  V_LENGTH <= 0  ORELSE  V_LENGTH > 1048576 THEN
18810         RETURN V_MEMORY
18820     END IF
18830     V_REACH = IIF(FL_NATIVE_ARCH() = 2, CLNGINT(&H07000000ULL), (CLNGINT(&H70000000ULL)))
18840     V_STEP = FL_MAX(65536LL, F_PAGE_SIZE())
#IFDEF FL_OS_WINDOWS
18850     GETSYSTEMINFO(V_INFO)
18860     V_STEP = FL_MAX(V_STEP, CLNGINT(V_INFO.ALLOCATION_GRANULARITY))
#ENDIF
18870     V_ALIGNED = (V_TARGET AND ((NOT (V_STEP - 1))))
18880     FOR V_DELTA = V_STEP TO V_REACH - V_STEP STEP V_STEP
18890         FOR V_DIRECTION = -1 TO 1 STEP 2
18900             IF V_DIRECTION < 0  ANDALSO  V_ALIGNED <= V_DELTA THEN
18910                 CONTINUE FOR
18920             END IF
18930             IF V_DIRECTION > 0  ANDALSO  V_ALIGNED > &H7FFFFFFFFFFFFFFFLL - V_DELTA THEN
18940                 CONTINUE FOR
18950             END IF
18960             V_HINT = V_ALIGNED + V_DIRECTION*V_DELTA
#IFDEF FL_OS_WINDOWS
18970             V_MEMORY = VIRTUALALLOC(V_HINT, V_LENGTH, CLNGINT(&H3000ULL), 4LL)
#ELSEIF DEFINED(FL_OS_MACOS)
18980             V_ALLOCATED = V_HINT
18990             IF MACH_VM_ALLOCATE(FL_TASK_SELF(), V_ALLOCATED, V_LENGTH, 0LL) = 0 THEN
19000                 V_MEMORY = CAST(ANY PTR, V_ALLOCATED)
19010             ELSE
19020                 V_MEMORY = 0
19030             END IF
#ELSE
19040             V_MEMORY = MMAP(V_HINT, V_LENGTH, 3LL, 34LL, -1LL, 0LL)
19050             IF CLNGINT(V_MEMORY) = -1 THEN
19060                 V_MEMORY = 0
19070             END IF
#ENDIF
19080             IF  NOT  (V_MEMORY <> 0) THEN
19090                 CONTINUE FOR
19100             END IF
19110             V_ALLOCATED = CLNGINT(V_MEMORY)
19120             IF V_ALLOCATED > 0  ANDALSO  ABS(V_ALLOCATED - V_TARGET) < V_REACH THEN
19130                 RETURN V_MEMORY
19140             END IF
19150             FL_RELEASE(V_MEMORY, V_LENGTH)
19160             V_MEMORY = 0
19170         NEXT
19180     NEXT
19190     RETURN V_MEMORY
19200 END FUNCTION

19210 FUNCTION FL_SEAL CDECL ALIAS "fl_seal"(BYVAL V_MEMORY AS ANY PTR, BYVAL V_LENGTH AS ULONGINT) AS LONG
19220     DIM V_ADDRESS AS LONGINT
19230     DIM V_STATUS AS LONG
19240     DIM V_PREVIOUS AS LONG
19250     DIM V_SUCCESS AS LONG
19260     V_SUCCESS = 0
19270     V_ADDRESS = CLNGINT(V_MEMORY)
#IFDEF FL_OS_WINDOWS
19280     V_STATUS = VIRTUALPROTECT(V_ADDRESS, V_LENGTH, 32LL, V_PREVIOUS)
19290     IF V_STATUS <> 0 THEN
19300         V_SUCCESS = 1
19310     END IF
#ELSE
19320     V_STATUS = MPROTECT(V_ADDRESS, V_LENGTH, 5LL)
19330     IF V_STATUS = 0 THEN
19340         V_SUCCESS = 1
19350     END IF
#ENDIF
19360     IF V_SUCCESS <> 0 THEN
19370         V_SUCCESS = FL_FLUSH_CODE(V_MEMORY, V_LENGTH)
19380     END IF
19390     RETURN V_SUCCESS
19400 END FUNCTION

19410 SUB FL_RELEASE CDECL ALIAS "fl_release"(BYVAL V_MEMORY AS ANY PTR, BYVAL V_LENGTH AS ULONGINT)
19420     DIM V_IGNORED AS LONG
#IFDEF FL_OS_WINDOWS
19430     V_IGNORED = VIRTUALFREE(V_MEMORY, 0LL, CLNGINT(&H8000ULL))
#ELSE
19440     V_IGNORED = MUNMAP(V_MEMORY, V_LENGTH)
#ENDIF
19450 END SUB

19460 FUNCTION F_SET_PROTECTION CDECL(BYVAL V_ADDRESS AS LONGINT, BYVAL V_LENGTH AS ULONGINT, BYVAL V_PROTECTION AS LONG, BYVAL V_WRITABLE AS LONG) AS LONG
19470     DIM V_DESIRED AS LONG
19480     DIM V_STATUS AS LONG
19490     DIM V_PREVIOUS AS LONG
19500     DIM V_SUCCESS AS LONG
#IFDEF FL_OS_WINDOWS
19510     V_DESIRED = IIF(V_WRITABLE, 64LL, (V_PROTECTION))
19520     V_STATUS = VIRTUALPROTECT(V_ADDRESS, V_LENGTH, V_DESIRED, V_PREVIOUS)
19530     V_SUCCESS = V_STATUS <> 0
#ELSEIF DEFINED(FL_OS_MACOS)
19540     REM DARWIN W^X TEMPORARILY REMOVES EXECUTE FROM THE WHOLE PAGE.
19550     V_DESIRED = IIF(V_WRITABLE, 19LL, (V_PROTECTION))
19560     V_STATUS = MACH_VM_PROTECT(FL_TASK_SELF(), V_ADDRESS, V_LENGTH, 0LL, V_DESIRED)
19570     V_SUCCESS = V_STATUS = 0
#ELSE
19580     V_DESIRED = IIF(V_WRITABLE, 7LL, (V_PROTECTION))
19590     V_STATUS = MPROTECT(V_ADDRESS, V_LENGTH, V_DESIRED)
19600     V_SUCCESS = V_STATUS = 0
#ENDIF
19610     RETURN V_SUCCESS
19620 END FUNCTION

19630 FUNCTION F_RESTORE_PROTECTIONS CDECL() AS LONG
19640     DIM V_INDEX AS LONG
19650     DIM V_RESTORED AS LONG
19660     V_RESTORED = (-1)
19670     FOR V_INDEX = V_RECOVERY_COUNT TO 1 STEP -1
19680         IF  NOT  F_SET_PROTECTION(V_RECOVERY_PAGES[V_INDEX - 1], V_RECOVERY_PAGE_SIZE, V_RECOVERY_MAPPINGS[V_INDEX - 1].PROTECTION, 0) THEN
19690             V_RESTORED = 0
19700         END IF
19710     NEXT
19720     IF V_RESTORED THEN
19730         V_RECOVERY_COUNT = 0
19740     END IF
19750     RETURN V_RESTORED
19760 END FUNCTION

19770 FUNCTION FL_EXCHANGE CDECL ALIAS "fl_exchange"(BYVAL V_ADDRESS AS LONGINT, BYVAL V_EXPECTED AS ANY PTR, BYVAL V_REPLACEMENT AS ANY PTR, BYVAL V_LENGTH AS ULONGINT) AS LONG
19780     DIM S_ORIGINAL(0 TO 64 - 1) AS BYTE
19790     DIM V_ORIGINAL AS BYTE PTR = @S_ORIGINAL(0)
19800     DIM V_EXPECTED_BYTES AS BYTE PTR
19810     DIM N_EXPECTED_BYTES AS LONGINT
19820     DIM V_REPLACEMENT_BYTES AS BYTE PTR
19830     DIM N_REPLACEMENT_BYTES AS LONGINT
19840     DIM V_DESTINATION AS BYTE PTR
19850     DIM N_DESTINATION AS LONGINT
19860     DIM S_MAPPINGS(0 TO 2 - 1) AS MEMORY_MAPPING
19870     DIM V_MAPPINGS AS MEMORY_MAPPING PTR = @S_MAPPINGS(0)
19880     DIM S_PAGES(0 TO 2 - 1) AS LONGINT
19890     DIM V_PAGES AS LONGINT PTR = @S_PAGES(0)
19900     DIM V_GRANULARITY AS ULONGINT
19910     DIM V_COUNT AS LONG
19920     DIM V_INDEX AS LONG
19930     DIM V_CHANGED AS LONG
19940     DIM V_IDENTICAL AS LONG
19950     DIM V_STATUS AS LONG
19960     V_STATUS = 0
19970     IF  NOT  F_RESTORE_PROTECTIONS() THEN
19980         V_STATUS = -1
19990         RETURN V_STATUS
20000     END IF
20010     V_GRANULARITY = F_PAGE_SIZE()
20020     IF V_GRANULARITY <= 0  ORELSE  V_LENGTH <= 0  ORELSE  V_LENGTH > 64 THEN
20030         RETURN V_STATUS
20040     END IF
20050     IF V_ADDRESS <= 0  ORELSE  V_ADDRESS > &H7FFFFFFFFFFFFFFFLL - V_LENGTH THEN
20060         RETURN V_STATUS
20070     END IF
20080     IF  NOT  (V_EXPECTED <> 0)  ORELSE   NOT  (V_REPLACEMENT <> 0) THEN
20090         RETURN V_STATUS
20100     END IF
20110     V_PAGES[0] = (V_ADDRESS AND ((NOT (V_GRANULARITY - 1))))
20120     V_PAGES[2 - 1] = (V_ADDRESS + V_LENGTH - 1 AND ((NOT (V_GRANULARITY - 1))))
20130     V_COUNT = IIF(V_PAGES[0] = V_PAGES[2 - 1], 1, (2))
20140     FOR V_INDEX = 1 TO V_COUNT
20150         IF  NOT  F_QUERY_MAPPING(V_PAGES[V_INDEX - 1], V_MAPPINGS[V_INDEX - 1]) THEN
20160             RETURN V_STATUS
20170         END IF
20180         IF  NOT  F_READABLE(V_MAPPINGS[V_INDEX - 1].PROTECTION)  ORELSE    NOT  F_EXECUTABLE(V_MAPPINGS[V_INDEX - 1].PROTECTION) THEN
20190             RETURN V_STATUS
20200         END IF
20210     NEXT
20220     IF FL_READ(V_ADDRESS, V_ORIGINAL, V_LENGTH) = 0 THEN
20230         RETURN V_STATUS
20240     END IF
20250     V_EXPECTED_BYTES = CAST(BYTE PTR, V_EXPECTED)
20260     N_EXPECTED_BYTES = V_LENGTH
20270     V_REPLACEMENT_BYTES = CAST(BYTE PTR, V_REPLACEMENT)
20280     N_REPLACEMENT_BYTES = V_LENGTH
20290     IF (MEMCMP(V_ORIGINAL, V_EXPECTED_BYTES, V_LENGTH) <> 0) THEN
20300         RETURN V_STATUS
20310     END IF
20320     V_CHANGED = 0
20330     FOR V_INDEX = 1 TO V_COUNT
20340         IF  NOT  F_SET_PROTECTION(V_PAGES[V_INDEX - 1], V_GRANULARITY, V_MAPPINGS[V_INDEX - 1].PROTECTION, (-1)) THEN
20350             EXIT FOR
20360         END IF
20370         V_CHANGED = V_CHANGED + 1
20380     NEXT
20390     IF V_CHANGED = V_COUNT THEN
20400         V_DESTINATION = CAST(BYTE PTR, CAST(ANY PTR, V_ADDRESS))
20410         N_DESTINATION = V_LENGTH
20420         V_IDENTICAL = (MEMCMP(V_DESTINATION, V_EXPECTED_BYTES, V_LENGTH) = 0)
20430         IF V_IDENTICAL THEN
20440             MEMCPY((@V_DESTINATION[0]), V_REPLACEMENT_BYTES, (((N_DESTINATION + 1 - 1)) - (1) + 1) * SIZEOF(BYTE))
20450             V_STATUS = IIF(FL_FLUSH_CODE(V_DESTINATION, V_LENGTH) <> 0, 1, (-1))
20460         END IF
20470     END IF
20480     MEMCPY((@V_RECOVERY_MAPPINGS[0]), V_MAPPINGS, (((2 + 1 - 1)) - (1) + 1) * SIZEOF(MEMORY_MAPPING))
20490     MEMCPY((@V_RECOVERY_PAGES[0]), V_PAGES, (((2 + 1 - 1)) - (1) + 1) * SIZEOF(LONGINT))
20500     V_RECOVERY_PAGE_SIZE = V_GRANULARITY
20510     V_RECOVERY_COUNT = V_CHANGED
20520     IF  NOT  F_RESTORE_PROTECTIONS() THEN
20530         V_STATUS = -1
20540     END IF
20550     RETURN V_STATUS
20560 END FUNCTION
